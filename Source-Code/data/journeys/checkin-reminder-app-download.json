{
  "useCaseId": "checkin-reminder-app-download",
  "name": "Check-in Reminder with App Download Journey",
  "category": {
    "categoryId": "engagement-journey",
    "categoryName": "Engagement"
  },
  "journeyTable": {
    "journeyName": "Check-in Reminder with App Download",
    "journeyGoal": "Remind users to check-in and encourage app download",
    "entryTrigger": "user_checkin_pending",
    "journeyCategory": "Engagement",
    "totalDuration": "1 day",
    "exitClause": "Exit after app download or check-in"
  },
  "entryCriteria": {
    "event": "user_checkin_pending",
    "eventId": "evt_checkin_001",
    "conditions": [
      {
        "field": "appInstalled",
        "operator": "EQUALS",
        "value": "FALSE"
      }
    ],
    "identity": {
      "primaryId": "customerId",
      "namespace": "ECID"
    },
    "audienceName": "Users Pending Check-in"
  },
  "touchpoints": [
    {
      "tpId": "TP1",
      "label": "In-App Check-in Reminder",
      "timing": {
        "offsetHours": 2
      },
      "channel": "IN_APP",
      "messageTheme": "Don't forget to check-in – download our app for faster access!",
      "cta": "Check-in Now",
      "tracking": {
        "campaignId": "inapp_checkin_reminder",
        "deliveryId": "del_inapp_13",
        "trackingEvents": [
          "inapp_view",
          "app_download"
        ]
      }
    }
  ],
  "journey": {
    "type": "event-based",
    "nodes": [
      {
        "id": "n1",
        "type": "ENTRY",
        "event": "user_checkin_pending",
        "eventId": "evt_checkin_001"
      },
      {
        "id": "n2",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "app_download",
          "field": "appDownloaded",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n3"
      },
      {
        "id": "n3",
        "type": "WAIT",
        "durationHours": 2
      },
      {
        "id": "n4",
        "type": "MESSAGE",
        "tpId": "TP1"
      },
      {
        "id": "n5",
        "type": "EXIT"
      }
    ]
  },
  "exitConditions": [
    {
      "event": "app_download",
      "eventId": "evt_app_001",
      "condition": "appDownloaded == true",
      "action": "EXIT"
    }
  ],
  "ajoConfig": {
    "frequencyCapping": {
      "enabled": true,
      "maxMessagesPerUser": 1,
      "timeWindowHours": 24
    },
    "prioritization": {
      "priority": "HIGH"
    }
  },
  "tracking": {
    "globalEvents": [
      "app_download"
    ],
    "eventMapping": {
      "app_download": "evt_app_001"
    }
  },
  "analytics": {
    "primaryKPI": "app_download",
    "secondaryKPIs": [
      "inapp_view"
    ],
    "attribution": {
      "model": "multi_touch",
      "lookbackHours": 24
    }
  },
  "version": "1.0",
  "status": "READY"
}