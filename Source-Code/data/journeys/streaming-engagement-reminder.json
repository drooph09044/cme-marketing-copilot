{
  "useCaseId": "streaming-engagement-reminder",
  "name": "Streaming Engagement – Reminder Push Journey",
  "category": {
    "categoryId": "real-time-engagement",
    "categoryName": "Real-Time Engagement"
  },
  "journeyTable": {
    "journeyName": "Streaming Engagement – Reminder Push",
    "journeyGoal": "Remind users about ongoing streams to drive repeat viewing",
    "entryTrigger": "user_logged_in",
    "journeyCategory": "Engagement",
    "totalDuration": "1 day",
    "exitClause": "Exit after stream started"
  },
  "entryCriteria": {
    "event": "user_logged_in",
    "eventId": "evt_login_003",
    "conditions": [
      {
        "field": "subscriptionStatus",
        "operator": "EQUALS",
        "value": "ACTIVE"
      }
    ],
    "identity": {
      "primaryId": "customerId",
      "namespace": "ECID"
    },
    "audienceName": "Highly Engaged Fans – Reminder"
  },
  "touchpoints": [
    {
      "tpId": "TP1",
      "label": "Reminder Push",
      "timing": {
        "offsetHours": 2
      },
      "channel": "PUSH",
      "messageTheme": "Don’t miss key moments – tune in now",
      "cta": "Resume Stream",
      "tracking": {
        "campaignId": "inapp_stream_reminder_2",
        "deliveryId": "del_push_25",
        "trackingEvents": [
          "push_open",
          "stream_start"
        ]
      }
    }
  ],
  "journey": {
    "type": "event-based",
    "nodes": [
      {
        "id": "n1",
        "type": "ENTRY",
        "event": "user_logged_in",
        "eventId": "evt_login_003"
      },
      {
        "id": "n2",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "stream_start",
          "field": "streamStarted",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n3"
      },
      {
        "id": "n3",
        "type": "WAIT",
        "durationHours": 2
      },
      {
        "id": "n4",
        "type": "MESSAGE",
        "tpId": "TP1"
      },
      {
        "id": "n5",
        "type": "EXIT"
      }
    ]
  },
  "exitConditions": [
    {
      "event": "stream_start",
      "eventId": "evt_stream_002",
      "condition": "streamStarted == true",
      "action": "EXIT"
    }
  ],
  "ajoConfig": {
    "frequencyCapping": {
      "enabled": true,
      "maxMessagesPerUser": 1,
      "timeWindowHours": 24
    },
    "prioritization": {
      "priority": "HIGH"
    }
  },
  "tracking": {
    "globalEvents": [
      "stream_start"
    ],
    "eventMapping": {
      "stream_start": "evt_stream_002"
    }
  },
  "analytics": {
    "primaryKPI": "stream_start",
    "secondaryKPIs": [
      "push_open"
    ],
    "attribution": {
      "model": "multi_touch",
      "lookbackHours": 24
    }
  },
  "version": "1.0",
  "status": "READY"
}