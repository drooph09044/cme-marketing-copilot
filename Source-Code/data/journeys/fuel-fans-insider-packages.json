      "action": "EXIT"
    }
  ],
  "ajoConfig": {
    "frequencyCapping": {
      "enabled": true,
      "maxMessagesPerUser": 4,
      "timeWindowHours": 336
    },
    "prioritization": {
      "priority": "HIGH"
    }
  },
  "tracking": {
    "globalEvents": [
      "email_open",
      "push_open",
      "content_click",
      "purchase_start"
    ],
    "eventMapping": {
      "package_purchase": "evt_package_purchase_001",
      "purchase_start": "evt_purchase_start_001"
    }
  },
  "analytics": {
    "primaryKPI": "package_purchase",
    "secondaryKPIs": [
