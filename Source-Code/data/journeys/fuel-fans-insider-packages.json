        "eventId": "evt_fan_affinity_001"
      },
      {
        "id": "n2",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "package_purchase",
          "field": "purchased",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n3"
      },
      {
        "id": "n3",
        "type": "WAIT",
        "durationHours": 0
      },
      {
        "id": "n4",
        "type": "MESSAGE",
        "tpId": "TP1"
      },
      {
        "id": "n5",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "package_purchase",
          "field": "purchased",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n6"
      },
      {
        "id": "n6",
        "type": "WAIT",
        "durationHours": 48
      },
      {
        "id": "n7",
        "type": "MESSAGE",
        "tpId": "TP2"
      },
      {
        "id": "n8",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "package_purchase",
          "field": "purchased",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n9"
      },
      {
        "id": "n9",
        "type": "WAIT",
        "durationHours": 72
      },
      {
        "id": "n10",
        "type": "MESSAGE",
        "tpId": "TP3"
      },
      {
        "id": "n11",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "package_purchase",
          "field": "purchased",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n12"
      },
      {
        "id": "n12",
        "type": "WAIT",
