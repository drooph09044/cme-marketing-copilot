{
  "useCaseId": "fuel-fans-insider-packages",
  "name": "Insider Fan Packages Journey",
  "category": {
    "categoryId": "monetization",
    "categoryName": "Fan Monetization"
  },
  "journeyTable": {
    "journeyName": "Insider Access & Packages",
    "journeyGoal": "Increase fan spend by promoting exclusive insider experiences, VIP access, and premium packages",
    "entryTrigger": "high_affinity_fan_detected",
    "journeyCategory": "Upsell",
    "totalDuration": "14 days",
    "exitClause": "Exit if fan purchases insider package or VIP upgrade"
  },
  "entryCriteria": {
    "event": "fan_affinity_score_update",
    "eventId": "evt_fan_affinity_001",
    "conditions": [
      {
        "field": "affinityScore",
        "operator": "GREATER_THAN_EQUALS",
        "value": 75
      },
      {
        "field": "isActiveFan",
        "operator": "EQUALS",
        "value": true
      }
    ],
    "identity": {
      "primaryId": "userId",
      "namespace": "ECID"
    },
    "audienceName": "High_Affinity_Fans"
  },
  "touchpoints": [
    {
      "tpId": "TP1",
      "label": "Insider Access Email",
      "timing": {
        "offsetHours": 0
      },
      "channel": "EMAIL",
      "messageTheme": "Get closer to the action than ever before",
      "cta": "Explore Insider Packages",
      "tracking": {
        "campaignId": "email_insider_1",
        "deliveryId": "del_insider_1",
        "trackingEvents": [
          "email_open",
          "content_click"
        ]
      }
    },
    {
      "tpId": "TP2",
      "label": "VIP Experience Push Notification",
      "timing": {
        "offsetHours": 48
      },
      "channel": "PUSH",
      "messageTheme": "Unlock VIP stadium experiences & backstage access",
      "cta": "View VIP Options",
      "tracking": {
        "campaignId": "push_insider_2",
        "deliveryId": "del_insider_2",
        "trackingEvents": [
          "push_open",
          "content_click"
        ]
      }
    },
    {
      "tpId": "TP3",
      "label": "Personalized Package Comparison Email",
      "timing": {
        "offsetHours": 120
      },
      "channel": "EMAIL",
      "messageTheme": "Choose your perfect fan experience",
      "cta": "Compare Packages",
      "tracking": {
        "campaignId": "email_insider_3",
        "deliveryId": "del_insider_3",
        "trackingEvents": [
          "email_open",
          "content_click"
        ]
      }
    },
    {
      "tpId": "TP4",
      "label": "Limited-Time VIP Upgrade Offer",
      "timing": {
        "offsetHours": 240
      },
      "channel": "SMS",
      "messageTheme": "Last chance to unlock exclusive access",
      "cta": "Upgrade Now",
