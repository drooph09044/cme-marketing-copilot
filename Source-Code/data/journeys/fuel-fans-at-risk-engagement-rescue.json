{
  "useCaseId": "fuel-fans-at-risk-engagement-rescue",
  "name": "At-Risk Fan Engagement Rescue Journey",
  "category": {
    "categoryId": "retention",
    "categoryName": "Fan Retention"
  },
  "journeyTable": {
    "journeyName": "Engagement Rescue",
    "journeyGoal": "Re-engage fans showing declining enthusiasm before they disengage or churn",
    "entryTrigger": "fan_engagement_score_decline",
    "journeyCategory": "Retention",
    "totalDuration": "10 days",
    "exitClause": "Exit if fan shows renewed engagement (viewing, attendance, or interaction)"
  },
  "entryCriteria": {
    "event": "fan_engagement_monitoring",
    "eventId": "evt_fan_engagement_002",
    "conditions": [
      {
        "field": "engagementScoreChange",
        "operator": "LESS_THAN_EQUALS",
        "value": -30
      },
      {
        "field": "lastInteractionDays",
        "operator": "GREATER_THAN_EQUALS",
        "value": 7
      }
    ],
    "identity": {
      "primaryId": "userId",
      "namespace": "ECID"
    },
    "audienceName": "At_Risk_Fans"
  },
  "touchpoints": [
    {
      "tpId": "TP1",
      "label": "We Miss You Email",
      "timing": {
        "offsetHours": 0
      },
      "channel": "EMAIL",
      "messageTheme": "Your team has missed you",
      "cta": "Catch Up Now",
      "tracking": {
        "campaignId": "email_atrisk_1",
        "deliveryId": "del_atrisk_1",
        "trackingEvents": [
          "email_open",
          "content_click"
        ]
      }
    },
    {
      "tpId": "TP2",
      "label": "Personalized Highlight Push",
      "timing": {
        "offsetHours": 48
      },
      "channel": "PUSH",
      "messageTheme": "Relive your favorite moments",
      "cta": "Watch Highlights",
      "tracking": {
        "campaignId": "push_atrisk_2",
        "deliveryId": "del_atrisk_2",
        "trackingEvents": [
          "push_open",
          "video_view"
        ]
      }
    },
    {
      "tpId": "TP3",
      "label": "Comeback Incentive Email",
      "timing": {
        "offsetHours": 96
      },
      "channel": "EMAIL",
      "messageTheme": "We’ve got something special for your return",
      "cta": "Unlock Offer",
      "tracking": {
        "campaignId": "email_atrisk_3",
        "deliveryId": "del_atrisk_3",
        "trackingEvents": [
          "email_open",
          "offer_click"
        ]
      }
    },
    {
      "tpId": "TP4",
      "label": "Last Chance SMS",
      "timing": {
        "offsetHours": 192
      },
      "channel": "SMS",
      "messageTheme": "Final chance to reconnect with your team",
      "cta": "Come Back Now",
