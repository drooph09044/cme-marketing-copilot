          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n6"
      },
      {
        "id": "n6",
        "type": "WAIT",
        "durationHours": 48
      },
      {
        "id": "n7",
        "type": "MESSAGE",
        "tpId": "TP2"
      },
      {
        "id": "n8",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "fan_reengagement_event",
          "field": "engaged",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n9"
      },
      {
        "id": "n9",
        "type": "WAIT",
        "durationHours": 48
      },
      {
        "id": "n10",
        "type": "MESSAGE",
        "tpId": "TP3"
      },
      {
        "id": "n11",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "fan_reengagement_event",
          "field": "engaged",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
