{
  "useCaseId": "lookalike-prospect-acquisition",
  "name": "Lookalike Prospect Acquisition Journey",
  "category": {
    "categoryId": "acquisition",
    "categoryName": "Acquisition"
  },
  "journeyTable": {
    "journeyName": "Lookalike Prospect Acquisition",
    "journeyGoal": "Acquire high-value lookalike prospects",
    "entryTrigger": "lookalike_match_detected",
    "journeyCategory": "Acquisition",
    "totalDuration": "21 days",
    "exitClause": "Exit after account creation"
  },
  "entryCriteria": {
    "event": "lookalike_match_detected",
    "eventId": "evt_ltv_001",
    "conditions": [
      {
        "field": "topLTVLookalike",
        "operator": "EQUALS",
        "value": true
      },
      {
        "field": "existingAccount",
        "operator": "EQUALS",
        "value": false
      }
    ],
    "identity": {
      "primaryId": "prospectId",
      "namespace": "THIRD_PARTY"
    },
    "audienceName": "High_Value_Lookalikes"
  },
  "touchpoints": [
    {
      "tpId": "TP1",
      "label": "Acquisition Campaign",
      "timing": {
        "offsetHours": 0
      },
      "channel": "DISPLAY_AD",
      "messageTheme": "Join customers who love our services",
      "cta": "Learn More",
      "tracking": {
        "campaignId": "display_ltv_acquisition",
        "deliveryId": "del_display_l1",
        "trackingEvents": [
          "ad_click",
          "account_created"
        ]
      }
    },
    {
      "tpId": "TP2",
      "label": "Prospect Nurture Email",
      "timing": {
        "offsetHours": 96
      },
      "channel": "EMAIL",
      "messageTheme": "See what makes us different",
      "cta": "Explore Benefits",
      "tracking": {
        "campaignId": "email_ltv_nurture",
        "deliveryId": "del_email_l2",
        "trackingEvents": [
          "email_open",
          "account_created"
        ]
      }
    }
  ],
  "journey": {
    "type": "event-based",
    "nodes": [
      {
        "id": "n1",
        "type": "ENTRY",
        "event": "lookalike_match_detected",
        "eventId": "evt_ltv_001"
      },
      {
        "id": "n2",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "account_created",
          "field": "accountCreated",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n3"
      },
      {
        "id": "n3",
        "type": "WAIT",
        "durationHours": 0
      },
      {
        "id": "n4",
        "type": "MESSAGE",
        "tpId": "TP1"
      },
      {
        "id": "n5",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "account_created",
          "field": "accountCreated",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n6"
      },
      {
        "id": "n6",
        "type": "WAIT",
        "durationHours": 96
      },
      {
        "id": "n7",
        "type": "MESSAGE",
        "tpId": "TP2"
      },
      {
        "id": "n8",
        "type": "EXIT"
      }
    ]
  },
  "exitConditions": [
    {
      "event": "account_created",
      "eventId": "evt_account_001",
      "condition": "accountCreated == true",
      "action": "EXIT"
    }
  ],
  "ajoConfig": {
    "frequencyCapping": {
      "enabled": true,
      "maxMessagesPerUser": 2,
      "timeWindowHours": 504
    },
    "prioritization": {
      "priority": "HIGH"
    }
  },
  "tracking": {
    "globalEvents": [
      "account_created"
    ],
    "eventMapping": {
      "account_created": "evt_account_001"
    }
  },
  "analytics": {
    "primaryKPI": "account_created",
    "secondaryKPIs": [
      "ad_click",
      "email_open"
    ],
    "attribution": {
      "model": "multi_touch",
      "lookbackHours": 504
    }
  },
  "version": "1.0",
  "status": "READY"
}