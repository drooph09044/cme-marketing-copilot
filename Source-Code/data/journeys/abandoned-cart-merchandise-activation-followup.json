{
  "useCaseId": "abandoned-cart-merchandise-activation-followup",
  "name": "Abandoned Cart: Merchandise – Activation Follow-up Journey",
  "category": {
    "categoryId": "engagement-journey",
    "categoryName": "Engagement"
  },
  "journeyTable": {
    "journeyName": "Abandoned Cart: Merchandise – Activation Follow-up",
    "journeyGoal": "Follow up with users who added merchandise to cart but did not complete purchase",
    "entryTrigger": "user_added_cart_merchandise",
    "journeyCategory": "Re-Engagement",
    "totalDuration": "2 days",
    "exitClause": "Exit after merchandise purchased or 2 days"
  },
  "entryCriteria": {
    "event": "user_added_cart_merchandise",
    "eventId": "evt_cart_merch_002",
    "conditions": [
      {
        "field": "cartStatus",
        "operator": "EQUALS",
        "value": "PENDING"
      }
    ],
    "identity": {
      "primaryId": "customerId",
      "namespace": "ECID"
    },
    "audienceName": "Added Merchandise Cart Users – Follow-up Activation"
  },
  "touchpoints": [
    {
      "tpId": "TP1",
      "label": "Merchandise Activation Follow-up Email",
      "timing": {
        "offsetHours": 1
      },
      "channel": "EMAIL",
      "messageTheme": "Complete your merchandise purchase now – items in your cart are waiting!",
      "cta": "Complete Purchase",
      "tracking": {
        "campaignId": "email_cart_merch_activation_followup",
        "deliveryId": "del_email_47",
        "trackingEvents": [
          "email_open",
          "merch_purchase"
        ]
      }
    },
    {
      "tpId": "TP2",
      "label": "Merchandise Activation Follow-up Push",
      "timing": {
        "offsetHours": 4
      },
      "channel": "PUSH",
      "messageTheme": "Your merchandise cart is waiting – complete your purchase now!",
      "cta": "Complete Purchase",
      "tracking": {
        "campaignId": "push_cart_merch_activation_followup",
        "deliveryId": "del_push_47",
        "trackingEvents": [
          "push_open",
          "merch_purchase"
        ]
      }
    }
  ],
  "journey": {
    "type": "event-based",
    "nodes": [
      {
        "id": "n1",
        "type": "ENTRY",
        "event": "user_added_cart_merchandise",
        "eventId": "evt_cart_merch_002"
      },
      {
        "id": "n2",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "merch_purchase",
          "field": "merchPurchased",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n3"
      },
      {
        "id": "n3",
        "type": "WAIT",
        "durationHours": 1
      },
      {
        "id": "n4",
        "type": "MESSAGE",
        "tpId": "TP1"
      },
      {
        "id": "n5",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "merch_purchase",
          "field": "merchPurchased",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n6"
      },
      {
        "id": "n6",
        "type": "WAIT",
        "durationHours": 3
      },
      {
        "id": "n7",
        "type": "MESSAGE",
        "tpId": "TP2"
      },
      {
        "id": "n8",
        "type": "EXIT"
      }
    ]
  },
  "exitConditions": [
    {
      "event": "merch_purchase",
      "eventId": "evt_merch_004",
      "condition": "merchPurchased == true",
      "action": "EXIT"
    }
  ],
  "ajoConfig": {
    "frequencyCapping": {
      "enabled": true,
      "maxMessagesPerUser": 2,
      "timeWindowHours": 48
    },
    "prioritization": {
      "priority": "HIGH"
    }
  },
  "tracking": {
    "globalEvents": [
      "merch_purchase"
    ],
    "eventMapping": {
      "merch_purchase": "evt_merch_004"
    }
  },
  "analytics": {
    "primaryKPI": "merch_purchase",
    "secondaryKPIs": [
      "email_open",
      "push_open"
    ],
    "attribution": {
      "model": "multi_touch",
      "lookbackHours": 48
    }
  },
  "version": "1.0",
  "status": "READY"
}