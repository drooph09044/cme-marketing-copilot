      },
      {
        "id": "n5",
        "type": "MESSAGE",
        "tpId": "TP2"
      },
      {
        "id": "n6",
        "type": "WAIT",
        "durationHours": 264
      },
      {
        "id": "n7",
        "type": "MESSAGE",
        "tpId": "TP3"
      },
      {
        "id": "n8",
        "type": "WAIT",
        "durationHours": 744
      },
      {
        "id": "n9",
        "type": "MESSAGE",
        "tpId": "TP4"
      },
      {
        "id": "n10",
        "type": "WAIT",
        "durationHours": 1080
      },
      {
        "id": "n11",
        "type": "MESSAGE",
        "tpId": "TP5"
      },
      {
        "id": "n12",
        "type": "EXIT"
      }
    ]
  },
  "exitConditions": [],
  "ajoConfig": {
    "frequencyCapping": {
      "enabled": true,
      "maxMessagesPerUser": 5,
