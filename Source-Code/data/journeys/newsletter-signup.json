  "journey": {
    "type": "event-based",
    "nodes": [
      {
        "id": "n1",
        "type": "ENTRY",
        "event": "website_visit",
        "eventId": "evt_web_001"
      },
      {
        "id": "n2",
        "type": "CONDITION",
        "condition": {
          "eventToCheck": "signup_completed",
          "field": "signupCompleted",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n3"
      },
      {
        "id": "n3",
        "type": "MESSAGE",
        "tpId": "TP1"
      },
      {
        "id": "n4",
        "type": "EXIT"
      }
    ]
  },
  "exitConditions": [
    {
      "event": "signup_completed",
      "eventId": "evt_signup_001",
      "condition": "subscribed == true",
      "action": "EXIT"
    }
  ],
