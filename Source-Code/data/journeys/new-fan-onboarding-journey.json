  "category": {
    "categoryId": "engagements",
    "categoryName": "Engagements"
  },
  "journeyTable": {
    "journeyName": "New Fan Onboarding Journey",
    "journeyGoal": "Onboard new fans and drive engagement, app adoption, and early monetization",
    "entryTrigger": "new_subscription",
    "journeyCategory": "Fan Engagement & Onboarding",
    "totalDuration": "21 days",
    "exitClause": "Exit when journey completed OR unsubscribe event"
  },
  "entryCriteria": {
    "event": "new_subscription",
    "eventId": "evt_new_subscription_001",
    "conditions": [
      {
        "field": "productType",
        "operator": "EQUALS",
        "value": "SEASON_TICKET"
      }
    ],
    "identity": {
      "primaryId": "customerId",
      "namespace": "ECID"
    },
    "audienceName": "New_Season_Ticket_Holders"
  },
