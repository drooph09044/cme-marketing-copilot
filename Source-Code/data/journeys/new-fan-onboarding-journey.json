  "exitConditions": [
    {
      "event": "unsubscribe",
      "eventId": "evt_unsubscribe_001",
      "action": "IMMEDIATE_EXIT"
    }
  ],
  "ajoConfig": {
    "frequencyCapping": {
      "enabled": true,
      "maxMessagesPerUser": 5,
      "timeWindowDays": 21
    },
    "suppressionRules": [
      {
        "ruleId": "unsubscribed_users",
        "condition": "unsubscribe == true"
      }
    ],
    "prioritization": {
      "priority": "MEDIUM"
    }
  },
  "tracking": {
    "globalEvents": [
      "journey_entered",
      "journey_exited",
      "app_download",
      "purchase_completed"
    ],
    "eventMapping": {
      "new_subscription": "evt_new_subscription_001",
      "unsubscribe": "evt_unsubscribe_001"
    }
