      "tracking": {
        "campaignId": "email_merch_offer",
        "deliveryId": "del_email_203",
        "trackingEvents": [
          "email_sent",
          "email_open",
          "email_click"
        ]
      },
      "personalization": [
        "favoritePlayer",
        "discountCode"
      ]
    },
    {
      "tpId": "TP4",
