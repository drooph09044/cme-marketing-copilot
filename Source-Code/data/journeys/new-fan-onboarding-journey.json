  "journey": {
    "type": "scheduled",
    "timeReference": "subscriptionStartDate",
    "nodes": [
      {
        "id": "n1",
        "type": "ENTRY",
        "event": "new_subscription",
        "eventId": "evt_new_subscription_001"
      },
      {
        "id": "n2",
        "type": "MESSAGE",
        "tpId": "TP1"
      },
      {
        "id": "n3",
