          "eventToCheck": "unsubscribe",
          "field": "unsubscribe",
          "operator": "EQUALS",
          "value": true
        },
        "trueBranch": "EXIT",
        "falseBranch": "n4"
      },
      {
        "id": "n4",
        "type": "WAIT",
