      "messageTheme": "Meet your rising star player",
      "cta": "Follow Player",
      "tracking": {
        "campaignId": "email_player_1",
        "deliveryId": "del_player_1",
        "trackingEvents": [
          "email_open",
          "profile_click"
        ]
      }
    },
    {
      "tpId": "TP2",
      "label": "Push Highlight Stats",
      "timing": {
        "offsetHours": 72
      },
      "channel": "PUSH",
      "messageTheme": "See how your player is performing this season",
      "cta": "View Stats",
      "tracking": {
        "campaignId": "push_player_2",
        "deliveryId": "del_player_2",
        "trackingEvents": [
          "push_open",
          "stats_view"
        ]
      }
    },
    {
      "tpId": "TP3",
      "label": "Video Moments Email",
      "timing": {
        "offsetHours": 168
      },
      "channel": "EMAIL",
      "messageTheme": "Top moments you shouldn’t miss",
