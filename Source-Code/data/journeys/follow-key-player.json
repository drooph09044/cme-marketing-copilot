{
  "useCaseId": "follow-key-player",
  "name": "Follow Key Player Journey",
  "category": {
    "categoryId": "engagement",
    "categoryName": "Fan Engagement"
  },
  "journeyTable": {
    "journeyName": "Follow Key Player",
    "journeyGoal": "Build long-term fan affinity by driving follows and engagement with key players",
    "entryTrigger": "team_content_engagement_detected",
    "journeyCategory": "Engagement",
    "totalDuration": "14 days",
    "exitClause": "Exit if fan follows player or engages with player profile twice"
  },
  "entryCriteria": {
    "event": "content_view",
    "eventId": "evt_player_interest_001",
    "conditions": [
      {
        "field": "playerContentViews",
        "operator": "GREATER_THAN_EQUALS",
        "value": 2
      }
    ],
    "identity": {
      "primaryId": "userId",
      "namespace": "ECID"
    },
    "audienceName": "Player_Interested_Fans"
  },
  "touchpoints": [
    {
      "tpId": "TP1",
      "label": "Player Spotlight Email",
      "timing": {
        "offsetHours": 0
