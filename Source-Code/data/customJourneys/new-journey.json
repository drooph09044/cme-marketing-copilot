          "value": "group_interest"
        },
        {
          "key": "cjaEvents",
          "value": "journeyEntry, audienceQualified"
        }
      ],
      "note": "Entry is triggered by group_interest."
    },
    {
      "id": "n1",
      "title": "Holdout Gate",
      "kind": "holdout",
      "accent": "#0FB8B8",
      "rows": [
        {
          "key": "holdoutPct",
          "value": "10%"
        },
        {
          "key": "assignment",
          "value": "deterministic hash on fanId"
        },
        {
          "key": "exitRule",
          "value": "immediate exit with passive measurement"
        },
        {
          "key": "cjaEvents",
          "value": "holdoutAssigned, liftBaselineTracked"
        }
      ],
      "note": "This node protects incrementality measurement by excluding the holdout population from message delivery."
    },
    {
      "id": "n2",
      "title": "A/B Split",
      "kind": "split",
      "accent": "#8B5CF6",
      "rows": [
        {
          "key": "variantA",
          "value": "50% standard cadence"
        },
        {
          "key": "variantB",
          "value": "50% personalized plus Gold early access"
        },
        {
          "key": "assignment",
          "value": "stable hash on fanId"
        },
        {
          "key": "cjaEvents",
          "value": "experimentAssigned, experimentExposure"
        }
      ],
      "note": "The split is deterministic so repeat entry checks keep a profile in the same arm."
    },
    {
      "id": "n3",
      "title": "Email 1A",
      "kind": "action",
      "accent": "#C89B3C",
      "rows": [
        {
          "key": "templateId",
          "value": "email_group_intro"
        },
        {
          "key": "subject",
          "value": "Bring Your Group \u2013 group ticket overview, pricing tiers, past group experience photos"
        },
        {
          "key": "sendTime",
          "value": "1 day after expressing interest"
        },
        {
          "key": "cjaEvents",
          "value": "email_sent, email_open, email_click"
        }
      ],
      "note": "Variant A follows the baseline messaging path from the imported journey definition."
    },
    {
      "id": "n3b",
      "title": "Email 1B",
      "kind": "action",
      "accent": "#E5C97A",
      "rows": [
        {
          "key": "templateId",
          "value": "email_group_quote"
        },
        {
          "key": "subject",
          "value": "Your Custom Quote \u2013 personalised group package proposal with deadline"
        },
        {
          "key": "sendTime",
          "value": "10 days after expressing interest"
        },
        {
          "key": "cjaEvents",
          "value": "email_sent, email_open, email_click"
        }
      ],
      "note": "Variant B follows the personalized arm from the imported journey definition."
    },
    {
      "id": "n4",
      "title": "Email Opened?",
      "kind": "decision",
      "accent": "#8B5CF6",
      "rows": [
        {
          "key": "condition",
          "value": "emailOpen within 24h"
        },
        {
          "key": "yesPath",
          "value": "wait 4 days before push"
        },
        {
          "key": "noPath",
          "value": "advance directly to push urgency"
        },
        {
          "key": "cjaEvents",
          "value": "decisionEvaluated, pathRouted"
        }
      ],
      "note": "This branch reduces over-messaging for profiles that already signaled interest with an open."
    },
    {
      "id": "n5",
      "title": "Wait 4d",
      "kind": "wait",
      "accent": "#4A9EF5",
      "rows": [
        {
          "key": "duration",
          "value": "P4D"
        },
        {
          "key": "exitRule",
          "value": "exit early if ticketPurchase is observed"
        },
        {
          "key": "reEval",
          "value": "check purchase event every 4h"
        },
        {
          "key": "cjaEvents",
          "value": "waitEntered, waitCompleted"
        }
      ],
      "note": "The wait node gives opened-email profiles a short buffer before the next paid-media touch."
    },
    {
      "id": "n6",
      "title": "Push 1",
      "kind": "action",
      "accent": "#F59E0B",
      "rows": [
        {
          "key": "templateId",
          "value": "ajo_push_urgency_d5"
        },
        {
          "key": "message",
          "value": "Only a limited number of seats remain for Game 62"
        },
        {
          "key": "deepLink",
          "value": "clippers://tickets/game-62?section={{seat_section}}"
        },
        {
          "key": "cjaEvents",
          "value": "pushSend, pushOpen, pushClick"
        }
      ],
      "note": "Push 1 is tuned for urgency and uses app deep linking when the profile is app-capable."
    },
    {
      "id": "n7",
      "title": "Push Clicked?",
      "kind": "decision",
      "accent": "#8B5CF6",
      "rows": [
        {
          "key": "condition",
          "value": "pushClick within 24h"
        },
        {
          "key": "yesPath",
          "value": "hold two days then continue nurturing"
        },
        {
          "key": "noPath",
          "value": "jump to purchase decision checkpoint"
        },
        {
          "key": "cjaEvents",
          "value": "decisionEvaluated, pushEngagement"
        }
      ],
      "note": "Push engagement is treated as a high-intent signal, so the next message is delayed slightly."
    },
    {
      "id": "n8",
      "title": "Wait 4d",
      "kind": "wait",
      "accent": "#4A9EF5",
      "rows": [
        {
          "key": "duration",
          "value": "P4D"
        },
        {
          "key": "exitRule",
          "value": "exit early on ticketPurchase"
        },
        {
          "key": "monitor",
          "value": "watch orderComplete and checkoutStart"
        },
        {
          "key": "cjaEvents",
          "value": "waitEntered, waitCompleted"
        }
      ],
      "note": "The retargeting wait keeps the journey from becoming noisy while conversion signals are monitored."
    },
    {
      "id": "n9",
      "title": "Email 2B",
      "kind": "action",
      "accent": "#E5C97A",
      "rows": [
        {
          "key": "templateId",
          "value": "group_booking_last_call"
        },
        {
          "key": "subject",
          "value": "Last chance \u2013 offer expiry reminder + rep direct contact for any questions"
        },
        {
          "key": "sendTime",
          "value": "21 days after expressing interest"
        },
        {
          "key": "cjaEvents",
          "value": "email_sent, email_open, email_click, call_attempted, call_connected"
        }
      ],
      "note": "This follow-up message reflects the latest imported email touchpoint."
    },
    {
      "id": "n10",
      "title": "Push 2",
      "kind": "action",
      "accent": "#F59E0B",
      "rows": [
        {
          "key": "templateId",
          "value": "ajo_push_last_chance_d1"
        },
        {
          "key": "message",
          "value": "Game 62 is tomorrow - this is the final chance to buy"
        },
        {
          "key": "deepLink",
          "value": "clippers://tickets/game-62"
        },
        {
          "key": "cjaEvents",
          "value": "pushSend, pushOpen, pushClick, purchaseAssist"
        }
      ],
      "note": "Push 2 is the final urgency touch and is intended to capture last-minute converters."
    },
    {
      "id": "n11",
      "title": "Ticket Purchased?",
      "kind": "decision",
      "accent": "#8B5CF6",
      "rows": [
        {
          "key": "condition",
          "value": "group_booking_confirmed within 21 days"
        },
        {
          "key": "yesPath",
          "value": "Exit Converted"
        },
        {
          "key": "noPath",
          "value": "Exit 21d TTL"
        },
        {
          "key": "cjaEvents",
          "value": "conversionChecked, pathRouted"
        }
      ],
      "note": "This decision is the primary conversion checkpoint used by both AJO exit logic and CJA reporting."
    },
    {
      "id": "n12",
      "title": "Exit Converted",
      "kind": "end",
      "accent": "#22C55E",
      "rows": [
        {
          "key": "trigger",
          "value": "group_booking_confirmed confirmed"
        },
        {
          "key": "suppression",
          "value": "stop all remaining messages"
        },
        {
          "key": "cjaEvents",
          "value": "journeyConversion, orderComplete"
        },
        {
          "key": "downstream",
          "value": "eligible for next lifecycle journey"
        }
      ],
      "note": "Converted profiles exit immediately and become eligible for the next fan-life-cycle experience."
    },
    {
      "id": "n13",
      "title": "Exit 21d TTL",
      "kind": "end",
      "accent": "#4A5568",
      "rows": [
        {
          "key": "trigger",
          "value": "journey reached 21-day time-to-live"
        },
        {
          "key": "suppression",
          "value": "remove from active journey audience"
        },
        {
          "key": "cjaEvents",
          "value": "journeyExpired"
        },
        {
          "key": "downstream",
          "value": "eligible for lapsed win-back audience"
        }
      ],
      "note": "TTL expiration closes the play without a conversion and prepares the profile for re-engagement logic."
    },
    {
      "id": "n14",
      "title": "Exit Holdout",
      "kind": "end",
      "accent": "#0FB8B8",
      "rows": [
        {
          "key": "trigger",
          "value": "holdout gate selected profile"
        },
        {
          "key": "delivery",
          "value": "no outbound channel actions"
        },
        {
          "key": "cjaEvents",
          "value": "holdoutAssigned, passiveLiftTracking"
        },
        {
          "key": "downstream",
          "value": "used only for incrementality comparison"
        }
      ],
      "note": "Holdout profiles never receive the journey treatment, but their downstream outcomes are still measured."
    }
  ],
