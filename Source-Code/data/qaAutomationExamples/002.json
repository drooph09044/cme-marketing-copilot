  "seed_replica": true,
  "prompts": [
    "Build an NFL fan birthday journey for the February cohort.",
    "Create a birthday wish journey for NFL fans with a birthday this month. First-of-month send for fans whose birthday is the 1st, otherwise birthday-morning at 10am ET. Wait 2 days then send a shop offer, and a final last-chance reminder 3 days before end of month. Suppress international and collapsed profiles.",
    "Need a birthday touchpoint for our February cohort \u2014 wish them happy birthday and pull them to the shop offer; route first-of-month birthdays to a separate template."
  ],
  "journey": {
    "schema_version": "0.1.0",
    "id": "nfl-birthday-journey",
    "metadata": {
      "name": "Birthday Journey",
      "internal_name": "NFL_Birthday_AlwaysOn_AJO",
      "brand": {
        "vertical": "sports_league",
        "league": "NFL",
        "team": null,
        "product": null
      },
      "purpose": "Wish fans a happy birthday from the NFL and drive engagement with personalized birthday content and a shop offer.",
      "archetype": "milestone_anniversary",
      "launch_date": "2026-01-01",
      "end_date": null,
      "always_on": true,
      "objectives": [
        {
          "rank": "primary",
          "description": "Drive engagement with NFL on fan birthdays through personalized content.",
          "kpi": "Email open rate / click rate on birthday touchpoints",
          "forecast": null
        },
        {
          "rank": "secondary",
          "description": "Drive shop purchases via birthday offer.",
          "kpi": "Shop conversions attributable to birthday journey",
          "forecast": null
        }
      ],
      "context": {
        "insights": null,
        "strategy": "Send a small set of high-personalization touchpoints around the fan's birthday: a wish on or near the birthday, then a final reminder of the shop offer 3 days before end of month.",
        "timing_rationale": "First of month send for fans whose birthday is the 1st; for all other fans, send on birthday at 10am EST. Wait 2 days, then offer. Final reminder 3 days before end of month.",
        "notes": "Drive all team managers (aka standard players) to smartlinks for every touchpoint. Priority is to get them on Fantasy app and keep them on Fantasy app."
      },
      "considerations": [
        "Confirm audience logic and size with FJM team."
      ],
      "capabilities_used": [
        "email",
        "push",
        "dynamic_content"
      ],
      "moments_that_matter": [
        "EXTEND MY EXPERIENCE"
      ]
    },
    "audiences": [
      {
        "id": "aud_1yr_active_with_birthdate",
        "name": "1 year active AND birth date filled out",
        "description": "Fans active in the last 1 year who have a birth date attribute populated.",
        "size_estimate": 8600000,
        "refresh": "dynamic",
        "criteria": {
          "all_of": [
            {
              "field": "activity.last_active_within_days",
              "op": "lte",
              "value": 365
            },
            {
              "field": "profile.birthdate",
              "op": "is_not_null"
            }
          ]
        }
      }
    ],
    "suppressions": [
      {
        "id": "supp_intl",
        "name": "International fans",
        "scope": "global",
        "criteria": {
          "field": "country",
          "op": "not_equals",
          "value": "US"
        }
      },
      {
        "id": "supp_other_month",
        "name": "Other month birthdays",
        "scope": "global",
        "criteria": {
          "field": "profile.birth_month",
          "op": "not_equals",
          "value": "<current_journey_month>"
        }
      },
      {
        "id": "supp_collapsed",
        "name": "Collapsed profiles",
        "scope": "global",
        "criteria": {
          "field": "profile_status",
          "op": "equals",
          "value": "collapsed"
        }
      }
    ],
    "channels": [
      {
        "id": "ch_email",
        "type": "email"
      },
      {
        "id": "ch_push",
        "type": "push",
        "platform": "nfl_app"
      }
    ],
    "personalization_tokens": [
      {
        "key": "FN",
        "name": "First Name"
      },
      {
        "key": "FT",
        "name": "Favorite Team"
      },
      {
        "key": "A",
        "name": "Age"
      }
    ],
    "reentry_policy": {
      "allowed": true,
      "cooldown": {
        "value": 1,
        "unit": "month"
      }
    },
    "frequency_caps": [],
    "nodes": [
