  "prompts": [
    "Build an MLS inactive-fan reactivation journey anchored to the major moments of the season.",
    "Create a season-long calendar reactivation journey for inactive MLS fans. Backbone touches at Opening Weekend, Concacaf Champions Cup, Leagues Cup, Decision Day, MLS Cup Playoffs, and MLS Cup Final. Each supporter gets one personalized touch on their favorite club's derby or marquee fixture during the season.",
    "Need to re-engage MLS fans who've gone inactive. Use the season's anchor moments as the backbone, plus an extra personalized fixture-day touch tied to fan's favorite club."
  ],
  "journey": {
    "schema_version": "0.1.0",
