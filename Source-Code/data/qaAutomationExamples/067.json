          "preview": "Your club is back on the pitch"
        },
        "personalization_used": ["FT", "MTC"],
        "dynamic_content": true
      },
      {
        "id": "email_leagues_cup",
        "type": "action",
        "label": "Email - Leagues Cup (Aug 4 - Sep 6)",
        "channel": "ch_email",
        "touch_id": "WK4",
        "timing": {"type": "scheduled", "calendar_date": "2026-08-04"},
        "copy": {"subject": "Leagues Cup kicks off: MLS vs Liga MX"}
      },
      {
        "id": "email_decision_day",
        "type": "action",
        "label": "Email - Decision Day (Nov 7)",
        "channel": "ch_email",
        "touch_id": "WK5",
        "timing": {"type": "scheduled", "calendar_date": "2026-11-07"},
        "copy": {"subject": "Decision Day: 14 matches, the playoff picture finalized"}
      },
      {
        "id": "email_playoffs",
        "type": "action",
        "label": "Email - Audi MLS Cup Playoffs begin",
        "channel": "ch_email",
        "touch_id": "WK6",
        "timing": {"type": "scheduled", "recurrence": "early november playoffs start"}
      },
      {
        "id": "email_mls_cup",
        "type": "action",
        "label": "Email - MLS Cup Final (Dec 18)",
        "channel": "ch_email",
        "touch_id": "WK7",
        "timing": {"type": "scheduled", "calendar_date": "2026-12-18"},
        "copy": {"subject": "MLS Cup Final tonight"}
      },
      {"id": "end_journey", "type": "end", "label": "Journey End", "reason": "completed"}
    ],
    "edges": [
      {"from": "start", "to": "email_opening_weekend"},
      {"from": "email_opening_weekend", "to": "email_champions_cup"},
      {"from": "email_champions_cup", "to": "dec_has_fav_club"},
      {"from": "dec_has_fav_club", "to": "email_personalized_derby", "branch_label": "yes"},
      {"from": "dec_has_fav_club", "to": "email_leagues_cup", "branch_label": "no"},
      {"from": "email_personalized_derby", "to": "email_leagues_cup"},
      {"from": "email_leagues_cup", "to": "email_decision_day"},
      {"from": "email_decision_day", "to": "email_playoffs"},
      {"from": "email_playoffs", "to": "email_mls_cup"},
      {"from": "email_mls_cup", "to": "end_journey"}
    ],
    "measurement": {
      "primary_kpis": [{"name": "Reactivated fan rate", "definition": "Fans inactive at start of journey who engaged with at least one touchpoint"}],
