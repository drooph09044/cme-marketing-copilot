      "internal_name": "MLS_Reactivation_2026",
      "brand": {"vertical": "sports_league", "league": "MLS", "team": null, "product": null},
      "purpose": "Re-engage inactive MLS fans across the 2026 season using a calendar-anchored cadence plus one personalized touch on fan's favorite club's derby or marquee fixture.",
      "archetype": "reactivation",
      "launch_date": "2026-02-01",
      "end_date": "2026-12-31",
      "always_on": false,
      "objectives": [
        {"rank": "primary", "description": "Reactivate inactive MLS fans across the season.", "kpi": "Fans returning to MLS App or MLS Season Pass with engagement", "forecast": null}
      ],
      "context": {
        "insights": null,
        "strategy": "Backbone of all-fans touches at major season moments (Opening Weekend, Champions Cup, Leagues Cup, Decision Day, Playoffs, Cup Final). Layer one per-club personalized touch on the fan's favorite club's derby or marquee fixture for additional relevance.",
        "timing_rationale": "Calendar-anchored to canonical MLS moments per the league's 2026 schedule.",
        "notes": "2026 is the final spring-to-fall MLS season before the calendar shift to fall-to-spring starting mid-2027."
      },
      "considerations": [],
      "capabilities_used": ["email"],
      "moments_that_matter": ["LEARN & FOLLOW", "GET PUMPED", "EXTEND MY EXPERIENCE"]
    },
    "audiences": [
      {
        "id": "aud_inactive_mls_fan",
        "name": "Inactive MLS fan",
        "description": "Fan with no MLS engagement in the last 365 days.",
        "criteria": {
          "all_of": [
            {"field": "country", "op": "in", "value": ["US", "CA"]},
            {"field": "mls.activity_last_active_within_days", "op": "gt", "value": 365}
          ]
        },
        "refresh": "dynamic"
      }
    ],
    "suppressions": [
      {
        "id": "supp_optout",
        "name": "Email opted out",
        "scope": "global",
        "criteria": {"field": "consent.email", "op": "equals", "value": false}
      }
    ],
    "channels": [{"id": "ch_email", "type": "email"}],
    "personalization_tokens": [
      {"key": "FT", "name": "Favorite Club"},
      {"key": "MTC", "name": "Matchup"}
    ],
    "reentry_policy": {"allowed": false},
    "frequency_caps": [],
    "nodes": [
      {"id": "start", "type": "start", "label": "Preseason kickoff", "entry_criteria": {"trigger": "schedule"}},
      {
        "id": "email_opening_weekend",
        "type": "action",
        "label": "Email - Opening Weekend (Feb 21)",
        "channel": "ch_email",
        "touch_id": "WK1",
        "timing": {"type": "scheduled", "calendar_date": "2026-02-21"},
        "copy": {"subject": "MLS is back: 2026 Opening Weekend"}
      },
      {
        "id": "email_champions_cup",
        "type": "action",
        "label": "Email - Concacaf Champions Cup window (Mar-May)",
        "channel": "ch_email",
        "touch_id": "WK2",
        "timing": {"type": "scheduled", "recurrence": "march-may champions cup window"}
      },
      {
        "id": "dec_has_fav_club",
        "type": "decision",
        "label": "Has favorite MLS club?",
