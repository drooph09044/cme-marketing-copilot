{
  "id": "079",
  "matrix_row_id": 79,
  "matrix_row_name": "Lapsed ESPN+ college football fan win-back",
  "template": "tpl_win_back",
  "league": "NCAA",
  "sport": "football",
  "scope": "league",
  "teams_referenced": "",
  "seed_replica": false,
  "prompts": [
    "Build an ESPN+ win-back journey for lapsed subscribers who follow college football.",
    "Create a 30/60/90-day win-back for lapsed ESPN+ subscribers with college football affinity. Storylines should tie to rivalry week, conference championship picture, or football transfer-portal news depending on time of year.",
    "Need to win back ESPN+ subscribers who care about college football. Three touches at 30, 60, 90 days post-lapse with rivalry-week and CFP-race hooks."
  ],
  "journey": {
    "schema_version": "0.1.0",
    "id": "ncaa-cfb-espn-plus-winback",
    "metadata": {
      "name": "Lapsed ESPN+ College Football Win-Back",
      "internal_name": "NCAA_CFB_ESPNPlus_WinBack_2026",
      "brand": {"vertical": "sports_league", "league": "NCAA", "team": null, "product": "ESPN+"},
      "purpose": "Win back lapsed ESPN+ subscribers with college football affinity using season-relevant storylines tied to rivalry week, conference championship picture, or football transfer-portal news.",
      "archetype": "win_back",
      "launch_date": "2026-08-15",
      "end_date": "2027-01-31",
      "always_on": false,
      "objectives": [
        {"rank": "primary", "description": "Reactivate lapsed ESPN+ subscribers with college football affinity.", "kpi": "Re-subscription rate among CFB-affinity lapsed users", "forecast": null}
      ],
      "context": {
        "insights": null,
        "strategy": "Standard 30/60/90 cadence anchored on lapse date. Storyline at each touch is timed to the college football calendar: conference openers and early-season ranked matchups in September, rivalry week in late November, CFP race in December, transfer-portal news in winter. Push reinforces email at Day 60 for opted-in fans on a fav-school kickoff Saturday.",
        "timing_rationale": "Anchored to subscription lapse date with fixed 30/60/90 cadence.",
        "notes": null
      },
      "considerations": [],
      "capabilities_used": ["email", "push"],
      "moments_that_matter": ["EXTEND MY EXPERIENCE"]
    },
    "audiences": [
      {
        "id": "aud_lapsed_espn_cfb",
        "name": "Lapsed ESPN+ subscriber with CFB affinity",
        "description": "ESPN+ subscriber whose subscription lapsed 30-120 days ago and whose viewing history shows college football affinity.",
        "criteria": {
          "all_of": [
            {"field": "espn_plus.status", "op": "equals", "value": "churned"},
            {"field": "espn_plus.days_since_lapse", "op": "between", "value": [30, 120]},
            {"field": "ncaa.favorite_school", "op": "is_not_null"},
            {"field": "ncaa.cfb_content_engagement_last_year", "op": "equals", "value": true}
          ]
        },
        "refresh": "dynamic"
      }
    ],
    "suppressions": [
      {"id": "supp_resubscribed", "name": "Already re-subscribed", "scope": "global", "criteria": {"field": "espn_plus.status", "op": "equals", "value": "active"}},
      {"id": "supp_optout", "name": "Email opted out", "scope": "global", "criteria": {"field": "consent.email", "op": "equals", "value": false}}
    ],
    "channels": [
      {"id": "ch_email", "type": "email"},
      {"id": "ch_push", "type": "push", "platform": "espn_app"}
    ],
    "personalization_tokens": [
      {"key": "FN", "name": "First Name"},
      {"key": "FT", "name": "Favorite School"}
    ],
    "reentry_policy": {"allowed": false},
    "frequency_caps": [],
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "label": "Entry: 30 days post-lapse",
        "entry_criteria": {
          "trigger": "audience_membership",
          "criteria": {"field": "espn_plus.days_since_lapse", "op": "equals", "value": 30}
        }
      },
      {
        "id": "email_d30_we_miss_you",
        "type": "action",
        "label": "Email Day 30 - We miss you (CFB seasonal hook)",
        "channel": "ch_email",
        "touch_id": "T30",
        "timing": {"type": "realtime"},
        "copy": {
          "subject": "{{FT}} kicked off without you - here's what you've missed",
          "cta_label": "Come back to ESPN+",
          "modules": [
            {"rank": "primary", "name": "Seasonal storyline (rivalry week / CFP race / transfer portal based on date)"},
            {"rank": "secondary", "name": "Top fav-school games available on ESPN+"}
          ]
        },
        "personalization_used": ["FN", "FT"],
        "dynamic_content": true
      },
      {
        "id": "wait_30_days",
        "type": "wait",
        "label": "Wait 30 days",
        "timing": {"type": "wait", "duration": {"value": 30, "unit": "day"}}
      },
      {
        "id": "dec_back_after_d30",
        "type": "decision",
        "label": "Already re-subscribed?",
        "decision_basis": "behavior",
        "condition": {"field": "espn_plus.status", "op": "equals", "value": "active"}
      },
      {
        "id": "email_d60_storyline",
        "type": "action",
        "label": "Email Day 60 - Rivalry / CFP race depth",
        "channel": "ch_email",
        "touch_id": "T60",
        "timing": {"type": "realtime"},
        "copy": {
          "subject": "{{FT}}'s path to the College Football Playoff",
          "cta_label": "Restart your ESPN+ subscription"
        },
        "personalization_used": ["FN", "FT"]
      },
      {
        "id": "dec_push_optin",
        "type": "decision",
        "label": "Push opted in (ESPN App)?",
        "decision_basis": "pull",
        "condition": {"field": "consent.push_espn_app", "op": "equals", "value": true}
      },
      {
        "id": "push_d60_optin",
        "type": "action",
        "label": "Push Day 60 - Fav-school Saturday kickoff",
        "channel": "ch_push",
        "touch_id": "P60",
        "timing": {"type": "realtime"},
        "copy": {"headline": "{{FT}} kicks off this Saturday - watch on ESPN+"}
      },
      {
        "id": "wait_30_more",
        "type": "wait",
        "label": "Wait 30 more days",
        "timing": {"type": "wait", "duration": {"value": 30, "unit": "day"}}
      },
      {
        "id": "dec_back_after_d60",
        "type": "decision",
        "label": "Already re-subscribed?",
        "decision_basis": "behavior",
        "condition": {"field": "espn_plus.status", "op": "equals", "value": "active"}
      },
      {
        "id": "email_d90_incentive",
        "type": "action",
        "label": "Email Day 90 - 30% renewal offer",
        "channel": "ch_email",
        "touch_id": "T90",
        "timing": {"type": "realtime"},
        "copy": {
          "subject": "Last invite back: 30% off ESPN+ through the CFP",
          "cta_label": "Renew at 30% off"
        }
      },
      {"id": "end_converted", "type": "end", "label": "Journey End - Reactivated", "reason": "converted"},
      {"id": "end_completed", "type": "end", "label": "Journey End - Completed", "reason": "completed"}
    ],
    "edges": [
      {"from": "start", "to": "email_d30_we_miss_you"},
      {"from": "email_d30_we_miss_you", "to": "wait_30_days"},
      {"from": "wait_30_days", "to": "dec_back_after_d30"},
      {"from": "dec_back_after_d30", "to": "end_converted", "branch_label": "yes"},
      {"from": "dec_back_after_d30", "to": "email_d60_storyline", "branch_label": "no"},
      {"from": "email_d60_storyline", "to": "dec_push_optin"},
      {"from": "dec_push_optin", "to": "push_d60_optin", "branch_label": "yes"},
      {"from": "dec_push_optin", "to": "wait_30_more", "branch_label": "no"},
      {"from": "push_d60_optin", "to": "wait_30_more"},
      {"from": "wait_30_more", "to": "dec_back_after_d60"},
      {"from": "dec_back_after_d60", "to": "end_converted", "branch_label": "yes"},
      {"from": "dec_back_after_d60", "to": "email_d90_incentive", "branch_label": "no"},
      {"from": "email_d90_incentive", "to": "end_completed"}
    ],
    "measurement": {
      "primary_kpis": [{"name": "CFB-affinity re-subscription rate"}],
      "secondary_kpis": [{"name": "Email open / click rates by seasonal storyline"}, {"name": "Push view rate at Day 60"}],
      "tests": []
    }
  }
}
