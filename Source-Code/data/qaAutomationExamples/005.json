      "name": "US Fanbase Reactivation - 2025 Season Timeline",
      "internal_name": "NFL_FanbaseReactivation_2025_Season",
      "brand": {
        "vertical": "sports_league",
        "league": "NFL",
        "team": null,
        "product": null
      },
      "purpose": "Re-engage inactive US fans across the 2025 NFL season using a calendar-based cadence of touchpoints tied to league moments and team rivalries.",
      "archetype": "reactivation",
      "launch_date": "2025-08-01",
      "end_date": "2026-02-15",
      "always_on": false,
      "objectives": [
        {
          "rank": "primary",
          "description": "Reactivate inactive US fans across the 2025 season.",
          "kpi": "Fans returning to NFL+ / NFL.com / NFL App with engagement after reactivation touch",
          "forecast": null
        }
      ],
      "context": {
        "insights": null,
        "strategy": "Calendar-driven touchpoint plan. All-fans touches at major league moments (Preseason, Kickoff, Thanksgiving, Superbowl). fav_team=null fans get the same major-moment touches. Fans with a fav_team receive one additional touch through the season at a team-specific divisional/rivalry moment.",
        "timing_rationale": "Aligns reactivation outreach to high-salience NFL calendar moments for the maximum chance of re-engagement.",
        "notes": null
      },
      "considerations": [],
      "capabilities_used": [
        "email",
        "push"
      ],
      "moments_that_matter": [
        "LEARN & FOLLOW",
        "GET PUMPED",
        "EXTEND MY EXPERIENCE"
      ]
    },
    "audiences": [
      {
        "id": "aud_all_inactive_fans",
        "name": "All inactive US fans",
        "description": "US fans with no NFL engagement in the last year.",
        "criteria": {
          "all_of": [
            {
              "field": "country",
              "op": "equals",
              "value": "US"
            },
            {
              "field": "activity.last_active_within_days",
              "op": "gt",
              "value": 365
            }
          ]
        },
        "refresh": "dynamic"
      },
      {
        "id": "aud_fav_team_null",
        "name": "Inactive fans without a favorite team",
        "criteria": {
          "all_of": [
            {
              "field": "country",
              "op": "equals",
              "value": "US"
            },
            {
              "field": "activity.last_active_within_days",
              "op": "gt",
              "value": 365
            },
            {
              "field": "favorite_team",
              "op": "is_null"
            }
          ]
        }
      },
      {
        "id": "aud_fav_team_not_null",
        "name": "Inactive fans with a favorite team",
        "criteria": {
          "all_of": [
            {
              "field": "country",
              "op": "equals",
              "value": "US"
            },
            {
              "field": "activity.last_active_within_days",
              "op": "gt",
              "value": 365
            },
            {
              "field": "favorite_team",
              "op": "is_not_null"
            }
          ]
        }
      }
    ],
