      "brand": {"vertical": "sports_league", "league": "NHL", "team": null, "product": "ESPN+ / NHL Streaming"},
      "purpose": "Win back lapsed ESPN+/NHL bundle subscribers via a 30/60/90 cadence with rivalry, playoff-race, and trade-deadline storyline hooks.",
      "archetype": "win_back",
