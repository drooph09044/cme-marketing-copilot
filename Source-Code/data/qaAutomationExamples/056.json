      "end_date": "2026-06-30",
      "always_on": false,
      "objectives": [
        {"rank": "primary", "description": "Reactivate lapsed ESPN+/NHL bundle subscribers.", "kpi": "Re-subscription rate among lapsed users", "forecast": null}
