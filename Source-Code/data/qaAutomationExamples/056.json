      },
      {
        "id": "push_d60_optin",
        "type": "action",
        "label": "Push Day 60 - Fav-team game tonight",
        "channel": "ch_push",
        "touch_id": "P60",
        "timing": {"type": "realtime"},
        "copy": {"headline": "{{FT}} drops the puck tonight - watch on ESPN+"}
      },
      {
        "id": "wait_30_more",
        "type": "wait",
        "label": "Wait 30 more days",
        "timing": {"type": "wait", "duration": {"value": 30, "unit": "day"}}
      },
      {
        "id": "dec_back_after_d60",
        "type": "decision",
        "label": "Already re-subscribed?",
        "decision_basis": "behavior",
        "condition": {"field": "espn_nhl_bundle.status", "op": "equals", "value": "active"}
      },
      {
        "id": "email_d90_incentive",
        "type": "action",
        "label": "Email Day 90 - Renewal incentive",
        "channel": "ch_email",
        "touch_id": "T90",
        "timing": {"type": "realtime"},
        "copy": {
          "subject": "Final invite back: 30% off through the Stanley Cup Final",
          "cta_label": "Renew at 30% off"
        }
      },
      {"id": "end_converted", "type": "end", "label": "Journey End - Reactivated", "reason": "converted"},
      {"id": "end_completed", "type": "end", "label": "Journey End - Completed", "reason": "completed"}
