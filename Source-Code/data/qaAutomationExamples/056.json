      "context": {
        "insights": null,
        "strategy": "Standard 30/60/90 cadence anchored on lapse date. Storyline at each touch is timed to the NHL calendar: rivalry games and Original Six matchups early-season, trade-deadline news in early March, Stanley Cup Playoffs from mid-April. Push reinforces email at Day 60 for opted-in fans.",
        "timing_rationale": "Anchored to subscription lapse date with fixed 30/60/90 cadence.",
        "notes": null
      },
      "considerations": [],
      "capabilities_used": ["email", "push", "dynamic_content"],
      "moments_that_matter": ["EXTEND MY EXPERIENCE"]
    },
    "audiences": [
