            {"rank": "secondary", "name": "Fav-team upcoming game schedule"}
          ]
        },
        "personalization_used": ["FN", "FT"],
        "dynamic_content": true
      },
      {
        "id": "wait_30_days",
        "type": "wait",
        "label": "Wait 30 days",
        "timing": {"type": "wait", "duration": {"value": 30, "unit": "day"}}
      },
      {
        "id": "dec_back_after_d30",
        "type": "decision",
        "label": "Already re-subscribed?",
        "decision_basis": "behavior",
        "condition": {"field": "espn_nhl_bundle.status", "op": "equals", "value": "active"}
