        "id": "aud_lapsed_nhl_bundle",
        "name": "Lapsed ESPN+/NHL bundle subscriber",
        "description": "Subscriber whose ESPN+/NHL bundle lapsed 30-120 days ago with prior NHL streaming engagement.",
        "criteria": {
          "all_of": [
            {"field": "espn_nhl_bundle.status", "op": "equals", "value": "churned"},
            {"field": "espn_nhl_bundle.days_since_lapse", "op": "between", "value": [30, 120]},
            {"field": "nhl.favorite_team", "op": "is_not_null"}
          ]
        },
        "refresh": "dynamic"
      }
    ],
    "suppressions": [
