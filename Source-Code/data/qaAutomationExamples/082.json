  "prompts": [
    "Build a college basketball inactive-fan reactivation journey across the season.",
    "Create a season-long calendar reactivation journey for inactive NCAA basketball fans. Backbone touches at Feast Week, conference play tip-off, Selection Sunday, and the Final Four. Each fan with a favorite school gets one personalized touch on their school's rivalry-game week.",
    "Need to re-engage college basketball fans who've gone inactive. Use the season's anchor moments as the backbone, plus an extra personalized rivalry-week touch tied to fan's favorite school."
  ],
  "journey": {
    "schema_version": "0.1.0",
    "id": "ncaa-cbb-inactive-reactivation-2026",
    "metadata": {
      "name": "NCAA Basketball Inactive Fan Reactivation - 2026 Season",
      "internal_name": "NCAA_CBB_Reactivation_2026",
      "brand": {"vertical": "sports_league", "league": "NCAA", "team": null, "product": null},
      "purpose": "Re-engage inactive NCAA basketball fans across the 2025-26 season using a calendar-anchored backbone plus a personalized rivalry-week touch on fan's favorite school.",
      "archetype": "reactivation",
      "launch_date": "2026-11-01",
      "end_date": "2027-04-06",
      "always_on": false,
      "objectives": [
        {"rank": "primary", "description": "Reactivate inactive college basketball fans across the season.", "kpi": "Fans returning to NCAA.com or partner apps with engagement", "forecast": null}
      ],
      "context": {
        "insights": null,
        "strategy": "Backbone of all-fans touches at major college basketball moments (Feast Week, conference play tip-off, Selection Sunday, Final Four). Layer one per-school personalized touch on fan's favorite school's rivalry-game week.",
        "timing_rationale": "Calendar-anchored to canonical NCAA basketball season moments per the 2025-26 schedule.",
        "notes": null
      },
      "considerations": [],
      "capabilities_used": ["email"],
      "moments_that_matter": ["LEARN & FOLLOW", "GET PUMPED", "EXTEND MY EXPERIENCE"]
    },
    "audiences": [
      {
        "id": "aud_inactive_cbb_fan",
        "name": "Inactive NCAA basketball fan",
        "description": "Fan with a college basketball affinity but no NCAA digital engagement in the last 365 days.",
        "criteria": {
          "all_of": [
            {"field": "country", "op": "equals", "value": "US"},
            {"field": "ncaa.basketball_affinity", "op": "equals", "value": true},
            {"field": "ncaa.activity_last_active_within_days", "op": "gt", "value": 365}
          ]
        },
        "refresh": "dynamic"
      }
    ],
    "suppressions": [
      {"id": "supp_optout", "name": "Email opted out", "scope": "global", "criteria": {"field": "consent.email", "op": "equals", "value": false}}
    ],
    "channels": [{"id": "ch_email", "type": "email"}],
    "personalization_tokens": [
      {"key": "FN", "name": "First Name"},
      {"key": "FT", "name": "Favorite School"},
      {"key": "MTC", "name": "Rivalry Matchup"}
    ],
    "reentry_policy": {"allowed": false},
    "frequency_caps": [],
    "nodes": [
      {"id": "start", "type": "start", "label": "Season cadence opens", "entry_criteria": {"trigger": "schedule"}},
      {
        "id": "email_feast_week",
        "type": "action",
        "label": "Email - Feast Week (late Nov)",
        "channel": "ch_email",
        "touch_id": "WK1",
        "timing": {"type": "scheduled", "calendar_date": "2026-11-23"},
        "copy": {"subject": "Feast Week tips off: marquee matchups all week"}
      },
      {
        "id": "email_conf_play_tipoff",
        "type": "action",
        "label": "Email - Conference play tip-off",
        "channel": "ch_email",
        "touch_id": "WK2",
        "timing": {"type": "scheduled", "calendar_date": "2026-12-29"},
        "copy": {"subject": "Conference play begins: the road to March"}
      },
      {
        "id": "dec_has_fav_school",
        "type": "decision",
        "label": "Has favorite school?",
        "decision_basis": "pull",
        "condition": {"field": "ncaa.favorite_school", "op": "is_not_null"}
      },
      {
        "id": "email_rivalry_personalized",
        "type": "action",
        "label": "Email - Personalized rivalry week for fav school",
        "channel": "ch_email",
        "touch_id": "WK3",
        "timing": {
          "type": "relative_to_event",
          "event": "fav_school_basketball_rivalry_game",
          "direction": "before",
          "offset": {"value": 3, "unit": "day"}
        },
        "copy": {
          "subject": "{{FT}} vs {{MTC}}: rivalry week tips off",
          "preview": "Your school's marquee matchup of the season"
        },
        "personalization_used": ["FN", "FT", "MTC"],
        "dynamic_content": true
      },
      {
        "id": "email_selection_sunday",
        "type": "action",
        "label": "Email - Selection Sunday (Mar 15)",
        "channel": "ch_email",
        "touch_id": "WK4",
        "timing": {"type": "scheduled", "calendar_date": "2027-03-14"},
        "copy": {"subject": "Selection Sunday: the bracket is set"}
      },
      {
        "id": "email_final_four",
        "type": "action",
        "label": "Email - Final Four weekend",
        "channel": "ch_email",
        "touch_id": "WK5",
        "timing": {"type": "scheduled", "calendar_date": "2027-04-03"},
        "copy": {"subject": "Final Four tips off Saturday in Indianapolis"}
      },
      {"id": "end_journey", "type": "end", "label": "Journey End", "reason": "completed"}
    ],
    "edges": [
      {"from": "start", "to": "email_feast_week"},
      {"from": "email_feast_week", "to": "email_conf_play_tipoff"},
      {"from": "email_conf_play_tipoff", "to": "dec_has_fav_school"},
      {"from": "dec_has_fav_school", "to": "email_rivalry_personalized", "branch_label": "yes"},
      {"from": "dec_has_fav_school", "to": "email_selection_sunday", "branch_label": "no"},
      {"from": "email_rivalry_personalized", "to": "email_selection_sunday"},
      {"from": "email_selection_sunday", "to": "email_final_four"},
      {"from": "email_final_four", "to": "end_journey"}
    ],
    "measurement": {
      "primary_kpis": [{"name": "Reactivated fan rate", "definition": "Fans inactive at start of journey who engaged with at least one touchpoint"}],
      "secondary_kpis": [{"name": "Per-touch open and click rates"}, {"name": "Rivalry-week personalized touch incremental lift"}],
      "tests": []
    }
  }
