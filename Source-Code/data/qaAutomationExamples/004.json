{
  "id": "004",
  "matrix_row_id": 4,
  "matrix_row_name": "Draft Tune-In - 2026",
  "template": "tpl_event_tune_in",
  "league": "NFL",
  "sport": "football",
  "scope": "league",
  "teams_referenced": "",
  "seed_replica": true,
  "prompts": [
    "Build a national tune-in journey for the 2026 NFL Draft.",
    "Create a Draft tune-in flow for fans nationally. 10% control holdout, then SMS-first for opted-in fans, email-first for others. Split paths based on whether the fan is a paid NFL+ subscriber: subscribers see retention messaging, non-subscribers see acquisition. Daily Draft-week emails T-3d through Day 3 with a post-draft recap +2 days. Push and SMS sequencing on Day 1 conditional on consent and subscription state.",
    "Need a Draft tune-in cadence \u2014 drive clicks on ways-to-watch and Draft viewership on NFL+. Two paths split by NFL+ subscription with a 10% holdout for measurement."
  ],
  "journey": {
    "schema_version": "0.1.0",
    "id": "nfl-draft-tunein-2024",
    "metadata": {
      "name": "2024 NFL Draft - Tune-In",
      "internal_name": "NFL_Multi_DraftTuneIn_Q1_2024_AJO",
      "brand": {
        "vertical": "sports_league",
        "league": "NFL",
        "team": null,
        "product": "NFL+"
      },
      "purpose": "Drive fans to click ways to watch Draft content and watch the Draft on NFL+/NFL Network.",
      "archetype": "content_engagement",
      "launch_date": "2024-04-01",
      "end_date": "2024-04-29",
      "always_on": false,
      "objectives": [
        {
          "rank": "primary",
          "description": "Drive clicks on ways to watch content.",
          "kpi": "# of fans who click ways to watch content"
        },
        {
          "rank": "primary",
          "description": "Drive fans to watch the Draft and Draft content on NFL+.",
          "kpi": "# of fans who watch Draft and/or Draft content on NFL+"
        },
        {
          "rank": "secondary",
          "description": "Reactivate fans with no activity in the last year.",
          "kpi": "# of fans with no activity in last year who engaged with this journey"
        },
        {
          "rank": "secondary",
          "description": "Drive purchase of Draft merch on NFLShop.com.",
          "kpi": "# of fans who purchase Draft merch from NFLShop.com"
        }
      ],
      "context": {
        "insights": null,
        "strategy": "Audience layered by activity recency + NFL+ subscription state + viewing history. Tune-In emphasizes how to watch, what content to expect, and post-draft recap content. Day-of touchpoints vary by subscription state.",
        "timing_rationale": "3-week ramp from 4/1 launch to 4/22 (Draft Week begins). Per-day messaging Draft Days 1-3 (4/25-4/27). Recap touch 4/29.",
        "notes": null
      },
      "considerations": [
        "Limited insight on Draft viewership outside of watching from NFL+."
      ],
      "capabilities_used": [
        "sms_via_attentive",
        "real_time_connections",
        "triggered_campaigns"
      ],
      "moments_that_matter": [
        "LEARN & FOLLOW",
        "GET PUMPED",
        "GET READY",
        "EXTEND MY EXPERIENCE"
      ]
    },
    "audiences": [
      {
        "id": "aud_tunein_layered",
        "name": "Tune-In layered audience",
        "description": "All 1 Year Active OR All 2 Year Active OR All 2023 viewers on NFL+ who watched at least once OR All Combine registrants & engagers OR All fans received from Peacock in 2023.",
        "criteria": {
          "any_of": [
            {
              "field": "activity.last_active_within_days",
              "op": "lte",
              "value": 365
            },
            {
              "field": "activity.last_active_within_days",
              "op": "lte",
              "value": 730
            },
            {
              "all_of": [
                {
                  "field": "nfl_plus.has_watched_2023",
                  "op": "equals",
                  "value": true
                },
                {
                  "field": "nfl_plus.watch_count_2023",
                  "op": "gte",
                  "value": 1
                }
              ]
            },
            {
              "field": "combine.registered_or_engaged",
              "op": "equals",
              "value": true
            },
            {
              "field": "peacock.received_2023",
              "op": "equals",
              "value": true
            }
          ]
        },
        "refresh": "dynamic"
      }
    ],
    "suppressions": [
      {
        "id": "supp_onepass_app_for_draft",
        "name": "Fans that have OnePass app downloaded for Draft OR registrants for Draft",
        "scope": "global",
        "criteria": {
          "any_of": [
            {
              "field": "onepass.downloaded_for_draft",
              "op": "equals",
              "value": true
            },
            {
              "field": "draft.registered",
              "op": "equals",
              "value": true
            }
          ]
        }
      }
    ],
