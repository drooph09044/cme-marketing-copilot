    "id": "ncaa-cfb-inactive-reactivation-2026",
    "metadata": {
      "name": "NCAA Football Inactive Fan Reactivation - 2026 Season",
      "internal_name": "NCAA_CFB_Reactivation_2026",
      "brand": {"vertical": "sports_league", "league": "NCAA", "team": null, "product": null},
      "purpose": "Re-engage inactive NCAA football fans across the 2026 season using a calendar-anchored backbone plus a personalized rivalry-week touch on fan's favorite school.",
      "archetype": "reactivation",
      "launch_date": "2026-08-15",
      "end_date": "2027-01-25",
      "always_on": false,
      "objectives": [
        {"rank": "primary", "description": "Reactivate inactive college football fans across the season.", "kpi": "Fans returning to NCAA.com or partner apps with engagement", "forecast": null}
      ],
      "context": {
        "insights": null,
        "strategy": "Backbone of all-fans touches at major college football season moments (Kickoff Weekend, conference openers, Rivalry Week, CFP Selection Day, CFP first-round). Layer one per-school personalized touch on fan's favorite school's rivalry-game week.",
        "timing_rationale": "Calendar-anchored to canonical NCAA football season moments per the 2026 schedule.",
        "notes": null
      },
      "considerations": [],
      "capabilities_used": ["email"],
      "moments_that_matter": ["LEARN & FOLLOW", "GET PUMPED", "EXTEND MY EXPERIENCE"]
    },
    "audiences": [
      {
        "id": "aud_inactive_cfb_fan",
        "name": "Inactive NCAA football fan",
        "description": "Fan with a college football affinity but no NCAA digital engagement in the last 365 days.",
        "criteria": {
          "all_of": [
            {"field": "country", "op": "equals", "value": "US"},
            {"field": "ncaa.football_affinity", "op": "equals", "value": true},
            {"field": "ncaa.activity_last_active_within_days", "op": "gt", "value": 365}
          ]
        },
        "refresh": "dynamic"
      }
    ],
    "suppressions": [
      {"id": "supp_optout", "name": "Email opted out", "scope": "global", "criteria": {"field": "consent.email", "op": "equals", "value": false}}
    ],
    "channels": [{"id": "ch_email", "type": "email"}],
    "personalization_tokens": [
      {"key": "FN", "name": "First Name"},
      {"key": "FT", "name": "Favorite School"},
      {"key": "MTC", "name": "Rivalry Matchup"}
    ],
    "reentry_policy": {"allowed": false},
    "frequency_caps": [],
    "nodes": [
      {"id": "start", "type": "start", "label": "Season cadence opens", "entry_criteria": {"trigger": "schedule"}},
      {
        "id": "email_kickoff_weekend",
        "type": "action",
        "label": "Email - Kickoff Weekend (late Aug)",
        "channel": "ch_email",
        "touch_id": "WK1",
        "timing": {"type": "scheduled", "calendar_date": "2026-08-29"},
        "copy": {"subject": "College football is back: Week 1 is here"}
      },
      {
        "id": "email_conference_openers",
        "type": "action",
        "label": "Email - Conference openers",
        "channel": "ch_email",
        "touch_id": "WK2",
        "timing": {"type": "scheduled", "calendar_date": "2026-09-26"},
        "copy": {"subject": "Conference play begins this Saturday"}
      },
      {
        "id": "dec_has_fav_school",
        "type": "decision",
        "label": "Has favorite school?",
        "decision_basis": "pull",
        "condition": {"field": "ncaa.favorite_school", "op": "is_not_null"}
      },
      {
        "id": "email_rivalry_personalized",
        "type": "action",
        "label": "Email - Personalized rivalry week for fav school",
        "channel": "ch_email",
        "touch_id": "WK3",
