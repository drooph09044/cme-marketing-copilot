      },
      {
        "id": "email_rivalry_week_general",
        "type": "action",
        "label": "Email - Rivalry Week roundup (last Sat of Nov)",
        "channel": "ch_email",
        "touch_id": "WK4",
        "timing": {"type": "scheduled", "calendar_date": "2026-11-28"},
        "copy": {"subject": "Rivalry Week: the biggest games on the slate"}
      },
      {
        "id": "email_cfp_selection_day",
        "type": "action",
        "label": "Email - CFP Selection Day (Dec 7)",
        "channel": "ch_email",
        "touch_id": "WK5",
        "timing": {"type": "scheduled", "calendar_date": "2026-12-07"},
        "copy": {"subject": "The 12-team CFP bracket is set"}
      },
      {
        "id": "email_cfp_first_round",
        "type": "action",
        "label": "Email - CFP first round (Dec 19-20)",
        "channel": "ch_email",
        "touch_id": "WK6",
        "timing": {"type": "scheduled", "calendar_date": "2026-12-19"},
        "copy": {"subject": "CFP first round kicks off tonight"}
      },
      {"id": "end_journey", "type": "end", "label": "Journey End", "reason": "completed"}
    ],
    "edges": [
      {"from": "start", "to": "email_kickoff_weekend"},
      {"from": "email_kickoff_weekend", "to": "email_conference_openers"},
      {"from": "email_conference_openers", "to": "dec_has_fav_school"},
      {"from": "dec_has_fav_school", "to": "email_rivalry_personalized", "branch_label": "yes"},
      {"from": "dec_has_fav_school", "to": "email_rivalry_week_general", "branch_label": "no"},
      {"from": "email_rivalry_personalized", "to": "email_rivalry_week_general"},
      {"from": "email_rivalry_week_general", "to": "email_cfp_selection_day"},
      {"from": "email_cfp_selection_day", "to": "email_cfp_first_round"},
      {"from": "email_cfp_first_round", "to": "end_journey"}
    ],
    "measurement": {
      "primary_kpis": [{"name": "Reactivated fan rate", "definition": "Fans inactive at start of journey who engaged with at least one touchpoint"}],
      "secondary_kpis": [{"name": "Per-touch open and click rates"}, {"name": "Rivalry-week personalized touch incremental lift"}],
      "tests": []
    }
  }
