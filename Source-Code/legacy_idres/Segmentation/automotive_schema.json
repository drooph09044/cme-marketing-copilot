    "connected_services_subscriptions": {
      "role": "behavioral",
      "description": "Connected service subscriptions per customer. One row per subscription. plan_name values: Connected Vehicle, Remote Access, Safety and Security, Premium. subscription_status values: Active, Cancelled, Expired, Trial. To find customers NOT on a plan use EXCLUDE operator. Example: customers not on Premium = plan_name EXCLUDE Premium.",
