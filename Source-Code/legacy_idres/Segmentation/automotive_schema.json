    "customers": {
      "role": "profile",
      "description": "Customer profile. One row per customer. customer_id is master key. Use for age, income_band, lifecycle_stage, churn_risk_score, ev_propensity_score, estimated_clv, generation, preferred_language, primary_state_province.",
