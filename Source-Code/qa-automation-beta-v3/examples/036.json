    "id": "nba-league-pass-winback-2026",
    "metadata": {
      "name": "Lapsed NBA League Pass Win-Back",
      "internal_name": "NBA_LeaguePass_WinBack_2026",
      "brand": {"vertical": "sports_league", "league": "NBA", "team": null, "product": "NBA League Pass"},
      "purpose": "Win back lapsed NBA League Pass subscribers via a 30/60/90-day cadence with NBA in-season storyline hooks and a final renewal incentive.",
      "archetype": "win_back",
      "launch_date": "2025-10-21",
      "end_date": "2026-06-30",
      "always_on": false,
      "objectives": [
        {"rank": "primary", "description": "Reactivate lapsed NBA League Pass subscribers in-season.", "kpi": "Re-subscription rate among lapsed users", "forecast": null}
      ],
      "context": {
        "insights": null,
        "strategy": "Day 30 'we miss you' email anchors on what the fan missed from their fav team. Day 60 hooks the season storyline — Emirates NBA Cup if early-winter, trade-deadline buzz if late January / early February, play-in race for late March. Day 90 closes with a renewal incentive.",
        "timing_rationale": "Anchored to subscription lapse date (Day 0).",
        "notes": null
      },
      "considerations": [],
      "capabilities_used": ["email", "push"],
      "moments_that_matter": ["EXTEND MY EXPERIENCE"]
    },
