      {"from": "push_d60", "to": "wait_30_more"},
      {"from": "wait_30_more", "to": "dec_resubscribed_d60"},
      {"from": "dec_resubscribed_d60", "to": "end_converted", "branch_label": "yes"},
      {"from": "dec_resubscribed_d60", "to": "email_d90", "branch_label": "no"},
      {"from": "email_d90", "to": "end_completed"}
    ],
    "measurement": {
      "primary_kpis": [{"name": "Re-subscription rate among lapsed users"}],
