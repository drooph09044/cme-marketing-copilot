      {
        "id": "aud_lapsed_league_pass",
        "name": "Lapsed NBA League Pass subscriber",
        "description": "Fan whose NBA League Pass subscription has expired in the last 120 days.",
        "criteria": {
          "all_of": [
            {"field": "league_pass.status", "op": "equals", "value": "churned"},
            {"field": "league_pass.days_since_lapse", "op": "between", "value": [30, 120]}
          ]
        },
        "refresh": "dynamic"
      }
    ],
    "suppressions": [
      {"id": "supp_resubscribed", "name": "Already re-subscribed", "scope": "global", "criteria": {"field": "league_pass.status", "op": "equals", "value": "active"}},
      {"id": "supp_optout", "name": "Email opted out", "scope": "global", "criteria": {"field": "consent.email", "op": "equals", "value": false}}
    ],
    "channels": [
      {"id": "ch_email", "type": "email"},
      {"id": "ch_push", "type": "push", "platform": "nba_app"}
    ],
    "personalization_tokens": [
      {"key": "FN", "name": "First Name"},
      {"key": "FT", "name": "Favorite Team"}
    ],
    "reentry_policy": {"allowed": false},
    "frequency_caps": [],
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "label": "Entry: 30 days post-lapse",
        "entry_criteria": {
          "trigger": "audience_membership",
          "criteria": {"field": "league_pass.days_since_lapse", "op": "equals", "value": 30}
        }
      },
      {
        "id": "email_d30",
        "type": "action",
        "label": "Email Day 30 - We miss you",
        "channel": "ch_email",
        "touch_id": "T30",
        "timing": {"type": "realtime"},
        "copy": {
          "subject": "Here's what you missed from {{FT}}",
          "preview": "Highlights, standings, and what's ahead",
          "cta_label": "Restart your subscription",
          "modules": [
            {"rank": "primary", "name": "Fav-team highlight reel"},
            {"rank": "secondary", "name": "Standings + remaining schedule"}
          ]
        },
        "personalization_used": ["FN", "FT"],
        "dynamic_content": true
      },
      {
        "id": "wait_30d",
        "type": "wait",
        "label": "Wait 30 days",
        "timing": {"type": "wait", "duration": {"value": 30, "unit": "day"}}
      },
      {
        "id": "dec_resubscribed_d30",
        "type": "decision",
        "label": "Already re-subscribed?",
        "decision_basis": "behavior",
        "condition": {"field": "league_pass.status", "op": "equals", "value": "active"}
      },
      {
        "id": "email_d60",
        "type": "action",
        "label": "Email Day 60 - Storyline hook (Cup / trade deadline / play-in)",
        "channel": "ch_email",
        "touch_id": "T60",
        "timing": {"type": "realtime"},
        "copy": {
          "subject": "{{FT}} is in the thick of it",
          "preview": "Emirates NBA Cup, trade-deadline buzz, play-in race",
          "cta_label": "Watch live on League Pass",
          "modules": [
            {"rank": "primary", "name": "Season storyline tied to date and fav team"},
            {"rank": "secondary", "name": "Fav-team next marquee game"}
          ]
        },
        "personalization_used": ["FN", "FT"],
        "dynamic_content": true
      },
      {
        "id": "dec_push_optin_d60",
        "type": "decision",
        "label": "Push opted in (NBA App)?",
        "decision_basis": "pull",
        "condition": {"field": "consent.push_nba_app", "op": "equals", "value": true}
      },
      {
        "id": "push_d60",
        "type": "action",
        "label": "Push Day 60 - Fav-team tonight",
        "channel": "ch_push",
        "touch_id": "P60",
        "timing": {"type": "realtime"},
        "copy": {"headline": "{{FT}} tipping off tonight - come back to League Pass"}
      },
      {
        "id": "wait_30_more",
        "type": "wait",
        "label": "Wait 30 more days",
        "timing": {"type": "wait", "duration": {"value": 30, "unit": "day"}}
      },
      {
        "id": "dec_resubscribed_d60",
        "type": "decision",
        "label": "Already re-subscribed?",
        "decision_basis": "behavior",
        "condition": {"field": "league_pass.status", "op": "equals", "value": "active"}
      },
      {
        "id": "email_d90",
        "type": "action",
        "label": "Email Day 90 - Renewal incentive",
        "channel": "ch_email",
        "touch_id": "T90",
        "timing": {"type": "realtime"},
        "copy": {
          "subject": "Come back to League Pass: 30% off through the playoffs",
          "cta_label": "Renew at 30% off"
        },
        "personalization_used": ["FN"]
      },
      {"id": "end_converted", "type": "end", "label": "Journey End - Reactivated", "reason": "converted"},
      {"id": "end_completed", "type": "end", "label": "Journey End - Completed", "reason": "completed"}
