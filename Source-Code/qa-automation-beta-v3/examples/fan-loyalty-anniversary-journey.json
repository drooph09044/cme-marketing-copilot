{
  "useCaseId": "fan-loyalty-anniversary-journey",
  "name": "Fan Loyalty Anniversary Journey",
  "category": {
    "categoryId": "loyalty-commerce",
    "categoryName": "Loyalty & Commerce"
  },
  "journeyTable": {
    "journeyName": "Fan Loyalty Anniversary Journey",
    "journeyGoal": "Celebrate fan milestones, strengthen emotional loyalty, and drive engagement through rewards and advocacy",
    "entryTrigger": "loyalty_anniversary",
    "journeyCategory": "Loyalty & Retention",
    "totalDuration": "7 days",
    "exitClause": "Exit when journey completed"
  },
  "entryCriteria": {
    "event": "loyalty_anniversary",
    "eventId": "evt_loyalty_anniversary_001",
    "conditions": [
      {
        "field": "isSeasonTicketHolder",
        "operator": "EQUALS",
        "value": true
      }
    ],
    "identity": {
      "primaryId": "customerId",
      "namespace": "ECID"
    },
    "audienceName": "Loyal_Season_Ticket_Holders"
  },
  "touchpoints": [
    {
      "tpId": "TP1",
      "label": "Day 0",
      "timing": {
        "relativeDay": 0,
        "description": "On anniversary date"
      },
      "channel": "EMAIL",
      "messageTheme": "Happy Anniversary – personalised milestone card (e.g. '10 Years as a Season Ticket Holder'); exclusive offer or recognition",
      "cta": "See Your Journey",
      "tracking": {
        "campaignId": "email_loyalty_anniversary",
        "deliveryId": "del_email_901",
        "trackingEvents": [
          "email_sent",
          "email_open",
          "email_click"
        ]
      },
      "personalization": [
        "firstName",
        "loyaltyTenure",
        "milestoneYears",
        "fanJourneyHighlights"
      ]
    },
    {
      "tpId": "TP2",
      "label": "Day 2",
      "timing": {
        "relativeDay": 2,
        "description": "2 days after anniversary"
      },
      "channel": [
        "PUSH",
        "EMAIL"
      ],
      "messageTheme": "A Gift From Us – exclusive loyalty reward (merch discount, priority access, stadium tour invite)",
      "cta": "Claim My Gift",
      "tracking": {
        "campaignId": "loyalty_reward_offer",
        "deliveryId": "del_push_email_902",
        "trackingEvents": [
          "push_sent",
          "push_click",
          "email_open",
          "email_click"
        ]
      },
      "personalization": [
        "rewardType",
        "discountCode"
      ]
    },
    {
      "tpId": "TP3",
      "label": "Day 7",
      "timing": {
        "relativeDay": 7,
        "description": "7 days after anniversary"
      },
      "channel": "EMAIL",
      "messageTheme": "Share Your Story – invite to fan spotlight programme; referral link",
      "cta": "Tell Us Your Story",
      "tracking": {
        "campaignId": "email_fan_story",
        "deliveryId": "del_email_903",
        "trackingEvents": [
          "email_sent",
          "email_open",
          "email_click"
        ]
      },
      "personalization": [
        "referralLink",
        "fanSinceYear"
      ]
    }
  ],
  "journey": {
    "type": "scheduled",
    "timeReference": "anniversaryDate",
    "nodes": [
      {
        "id": "n1",
        "type": "ENTRY",
        "event": "loyalty_anniversary",
        "eventId": "evt_loyalty_anniversary_001"
      },
      {
        "id": "n2",
        "type": "MESSAGE",
        "tpId": "TP1"
      },
      {
        "id": "n3",
        "type": "MESSAGE",
        "tpId": "TP2"
      },
      {
        "id": "n4",
        "type": "MESSAGE",
        "tpId": "TP3"
      },
      {
        "id": "n5",
        "type": "EXIT"
      }
    ]
  },
  "exitConditions": [],
  "ajoConfig": {
    "frequencyCapping": {
      "enabled": true,
      "maxMessagesPerUser": 3,
      "timeWindowDays": 7
    },
    "suppressionRules": [],
    "prioritization": {
      "priority": "MEDIUM"
    }
  },
  "tracking": {
    "globalEvents": [
      "journey_entered",
      "journey_exited",
      "reward_claimed",
