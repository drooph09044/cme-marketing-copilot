    }
  },
  "analytics": {
    "primaryKPI": "reward_claimed",
    "secondaryKPIs": [
      "email_open",
      "email_click",
      "push_click",
      "referral_submitted"
    ],
    "attribution": {
      "model": "multi_touch",
      "lookbackDays": 7
    }
