    "ajoConfig": {
      "frequencyCapping": {
        "enabled": true,
        "maxMessagesPerUser": 1,
        "timeWindowHours": 168
      },
      "prioritization": {
        "priority": "MEDIUM"
      }
    },
    "tracking": {
      "globalEvents": [
        "app_open"
      ],
