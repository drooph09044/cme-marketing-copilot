        "app_open": "evt_app_open_001"
      }
    },
    "analytics": {
      "primaryKPI": "app_open",
      "secondaryKPIs": [
        "email_open"
      ],
      "attribution": {
        "model": "single_touch",
        "lookbackHours": 168
      }
    },
    "version": "1.0",
    "status": "READY"
