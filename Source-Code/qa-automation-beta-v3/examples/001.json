  "league": "NFL",
  "sport": "football",
  "scope": "league",
  "seed_replica": true,
  "prompts": [
    "Build an NFL+ cart abandonment journey for fans who drop off at the credit card page.",
    "Create a cart abandonment flow for our NFL+ subscription product with five subscription-tier branches (Premium Annual, Premium Monthly, Annual, Monthly, Fallback). Audience should fan out across the four identity states (App Known, App Unknown, Web Known, Web Unknown). Cadence should be modal-first at the point of abandonment, then escalate to push and email on the next game day. Suppress current subscribers, international fans, and collapsed profiles. Allow re-entry once per month. Always-on journey through the season.",
    "I need an always-on abandonment journey for NFL+ subscriptions. Modal at the funnel entry, push and email on game days after the fact. Routing should respect whether the fan abandoned from app vs web. Cap re-entry at once per month."
  ],
  "journey": {
    "schema_version": "0.1.0",
    "id": "nfl-plus-abandon-cart-2026",
    "metadata": {
      "name": "Abandon Cart Journey",
      "internal_name": "NFL_AbandonCart_2026_AJO",
      "brand": {
        "vertical": "sports_league",
        "league": "NFL",
        "team": null,
        "product": "NFL+"
      },
      "purpose": "Recover fans who began an NFL+ subscription checkout but dropped off at the credit card page, by re-engaging them in their highest-converting channel and again on the next game day.",
      "archetype": "abandon_cart",
      "launch_date": "2026-06-01",
      "end_date": null,
      "always_on": true,
      "objectives": [
        {
          "rank": "primary",
          "description": "Convert abandon-cart fans to active NFL+ subscribers within the season.",
          "kpi": "Subscription conversions attributed to journey",
          "forecast": null
        }
      ],
      "context": {
        "insights": "2025: App Modal was the main closing channel (~75% of subs, ~28K clickers). Web Modal had highest conversion at funnel entry (10.75%) but only 6% of clickers (460K audience, 99.5% dropped pre-funnel). ~40% of conversions occur within 24 hours; the remaining ~60% over 2-30 days. Game-day conversions are concentrated: Sundays 12PM-4PM ET (67% of Sunday conversions); Mon/Thu evenings 6-10PM (78% of weekday subs).",
        "strategy": "Lead with converting channels (modals) before awareness channels (push/email). Show first touchpoints within 24 hours of cart abandonment. Supplement with push/email. Follow up on game days to reiterate need.",
        "timing_rationale": "Always-on through the season (Preseason through Playoffs) to capture steady, efficient conversions.",
        "notes": null
      },
      "considerations": [],
      "capabilities_used": [
        "realtime_outbound",
        "app_modal",
        "web_modal",
        "push",
        "email"
      ],
      "moments_that_matter": [
        "PLAN & COMMIT",
        "GET READY"
      ]
    },
