      "name": "2024 NFL Draft - Local (Detroit)",
      "internal_name": "NFL_Multi_DraftLocal_Q1_2024_AJO",
      "brand": {
        "vertical": "sports_league",
        "league": "NFL",
        "team": "DET",
        "product": "NFL Draft Experience"
      },
      "purpose": "Drive fans in the Detroit market to register for and attend the NFL Draft Experience, and drive OnePass app logins/usage.",
      "archetype": "event_promotion",
      "launch_date": "2024-03-19",
      "end_date": "2024-04-29",
      "always_on": false,
      "objectives": [
        {
          "rank": "primary",
          "description": "Drive NFL Draft experience registrations.",
          "kpi": "# of fans who register for NFL Draft Experience",
          "forecast": null
        },
        {
          "rank": "primary",
          "description": "Drive OnePass App logins/usage.",
          "kpi": "# of fans who logged into OnePass App",
          "forecast": null
        },
        {
          "rank": "secondary",
          "description": "Reactivate fans with no activity in the last year.",
          "kpi": "# of fans with no DB activity in last year who engaged (open/click) with any touchpoint",
          "forecast": null
        }
      ],
      "context": {
        "insights": null,
        "strategy": "Multi-channel sequenced journey from registration open through draft day, then post-draft recap. Use OnePass Realtime Outbound for next-best-message after registration; SMS via Attentive; two different Draft start dates (March 19 for Local, April 1 for Tune-In).",
        "timing_rationale": "Begin 3/19 with registration open; layer email + SMS + push + modal as Draft approaches; daily takeover content during Draft Days 1-3; recap touch 2 days after.",
        "notes": "CLUB ORCHESTRATION: send Clubs Toolkit. Simplified Local and Tune-In comms. LIONS ORCHESTRATION: hoping to coordinate with Lions for league local and custom Lions draft."
      },
      "considerations": [
        "NFL Draft Experience runs from 4/20-4/27.",
        "The local Draft Experience is a free event, but fans must be registered to attend.",
        "Draft registrations tentatively start 3/19."
      ],
      "capabilities_used": [
        "greencopper_onepass_direct_integration",
        "onepass_realtime_outbound",
        "sms_via_attentive",
        "real_time_connections",
        "triggered_campaigns"
      ],
      "moments_that_matter": [
        "LEARN & FOLLOW",
        "GET PUMPED",
        "LOOK AHEAD",
        "PLAN & COMMIT",
        "GET READY"
      ]
