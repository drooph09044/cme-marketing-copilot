    "audiences": [
      {
        "id": "aud_all_2yr_active_waterfall",
        "name": "All 2 Year Active (waterfall)",
        "description": "Composite waterfall audience layered across multiple targeting criteria.",
        "criteria": {
          "any_of": [
            {
              "field": "jebbit.registry_of_interest_2024",
              "op": "equals",
              "value": true
            },
            {
              "field": "geolocation.state",
              "op": "equals",
              "value": "MI"
            },
            {
              "expression": "(fav_team = CHI AND HMA = CHI AND ticket_purchased_2023 WHERE CHI_was_away) OR (fav_team = WAS AND HMA = WAS AND ticket_purchased_2023 WHERE WAS_was_away) repeat for NE, AZ, LAC, NYG, TEN, ATL, NYJ"
            },
            {
              "field": "lions.hma",
              "op": "equals",
              "value": true
            },
            {
              "field": "favorite_team",
              "op": "equals",
              "value": "DET"
            },
            {
              "field": "geolocation.miles_from_DET",
              "op": "lte",
              "value": 500
            },
            {
              "expression": "Shop purchasers from last 2 seasons that bought Lions merchandise"
            },
            {
              "expression": "All event attendees/registrants from last 2 seasons (Draft, PBG, SB, Combine, Kickoff)"
            },
            {
              "field": "onepass.downloaded_not_registered_draft_2024",
              "op": "equals",
              "value": true
            },
            {
              "field": "fantasy.season_2023_registered_joined_drafted",
              "op": "equals",
              "value": true
            },
            {
              "field": "nfl_com_app.draft_pages_visitor",
              "op": "equals",
              "value": true
            },
            {
              "field": "favorite_team",
              "op": "in",
              "value": [
                "CHI",
                "WAS",
                "NE",
                "AZ",
                "LAC",
                "NYG",
                "TEN",
                "ATL",
                "NYJ"
