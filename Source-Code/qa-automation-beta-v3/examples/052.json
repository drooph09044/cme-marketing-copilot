      },
      {
        "id": "aud_panthers_fan",
        "name": "Florida Panthers fan",
        "criteria": {"field": "favorite_team", "op": "equals", "value": "FLA"}
      },
      {
        "id": "aud_rangers_fan",
        "name": "New York Rangers fan",
        "criteria": {"field": "favorite_team", "op": "equals", "value": "NYR"}
      }
    ],
