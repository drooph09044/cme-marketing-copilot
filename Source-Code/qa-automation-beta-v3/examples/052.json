        "id": "aud_nhl_fan",
        "name": "Active NHL fan",
        "description": "Any fan with NHL app activity or NHL streaming engagement in the last 180 days.",
        "criteria": {"field": "nhl.activity_within_days", "op": "lte", "value": 180},
        "refresh": "dynamic"
      },
      {
        "id": "aud_miami_geo",
        "name": "Miami-area fan (within 100mi)",
