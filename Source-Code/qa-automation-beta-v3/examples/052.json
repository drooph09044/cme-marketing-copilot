      ],
      "context": {
        "insights": null,
        "strategy": "Two-week cadence with geo and team-affinity routing. Miami-area fans (within 100mi of loanDepot Park) see ticket-buy as primary CTA; all other fans see ESPN+ tune-in. Per-fav-team variants for Panthers and Rangers supporters use team-specific imagery. 10% control holdout to test whether the journey lifts viewership and ticket sales above baseline.",
        "timing_rationale": "Winter Classic kicks off Jan 2, 2026 at 5pm ET; cadence works backward from there.",
        "notes": null
      },
      "considerations": [],
      "capabilities_used": ["email", "push", "geo_filtering", "ab_test_holdout"],
      "moments_that_matter": ["GET PUMPED", "GET READY"]
