        "name": "MLB.TV annual subscriber approaching expiry",
        "criteria": {
          "all_of": [
            {"field": "mlb_tv.status", "op": "equals", "value": "active"},
            {"field": "mlb_tv.plan", "op": "equals", "value": "annual"},
            {"field": "mlb_tv.days_until_expiry", "op": "lte", "value": 30}
          ]
