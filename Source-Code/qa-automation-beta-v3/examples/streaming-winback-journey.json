{
  "useCaseId": "streaming-winback-journey",
  "name": "Streaming Win-Back Journey",
  "category": {
    "categoryId": "retention-churn",
    "categoryName": "Retention & Churn Prevention"
  },
  "journeyTable": {
    "journeyName": "Streaming Win-Back Journey",
    "journeyGoal": "Re-engage inactive users and reduce churn through personalized content recommendations and retention incentives",
    "entryTrigger": "user_inactive",
    "journeyCategory": "Retention & Churn Prevention",
    "totalDuration": "14 days",
    "exitClause": "Exit when user_resumed_activity OR subscription_cancelled OR journey completed"
  },
  "entryCriteria": {
    "event": "user_inactive",
    "eventId": "evt_user_inactive_001",
    "conditions": [
      {
        "field": "daysSinceLastLogin",
        "operator": "GREATER_THAN",
        "value": 14
      }
    ],
    "identity": {
      "primaryId": "userId",
      "namespace": "ECID"
    },
    "audienceName": "Inactive_Streaming_Users"
  },
  "touchpoints": [
    {
      "tpId": "TP1",
      "label": "Day 1",
      "timing": {
        "relativeDay": 1,
        "description": "1 day after entering win-back journey"
      },
      "channel": [
        "PUSH",
        "EMAIL"
      ],
      "messageTheme": "We noticed you've been away – 'pick up where you left off' content recommendation",
      "cta": "Resume Watching",
      "tracking": {
        "campaignId": "winback_resume_content",
        "deliveryId": "del_push_email_1201",
        "trackingEvents": [
          "push_sent",
          "push_click",
          "email_open",
          "email_click"
        ]
      },
      "personalization": [
        "firstName",
        "lastWatchedContent",
        "resumeTimestamp"
      ]
    },
    {
      "tpId": "TP2",
      "label": "Day 5",
      "timing": {
        "relativeDay": 5,
        "description": "5 days after entering win-back journey"
      },
      "channel": "EMAIL",
      "messageTheme": "Here's what's new – 2–3 new releases in subscriber's preferred genre since last login",
      "cta": "See What's New",
      "tracking": {
        "campaignId": "email_new_releases",
        "deliveryId": "del_email_1202",
        "trackingEvents": [
          "email_sent",
          "email_open",
          "email_click"
        ]
      },
      "personalization": [
        "preferredGenres",
        "newReleases",
        "recommendationList"
      ]
    },
    {
      "tpId": "TP3",
      "label": "Day 14",
      "timing": {
        "relativeDay": 14,
        "description": "14 days after entering win-back journey"
      },
      "channel": [
        "EMAIL",
        "SMS"
      ],
      "messageTheme": "Special offer just for you – retention discount or free month; time-limited",
      "cta": "Stay & Save",
      "tracking": {
        "campaignId": "winback_retention_offer",
        "deliveryId": "del_email_sms_1203",
        "trackingEvents": [
          "email_sent",
          "email_open",
          "email_click",
          "sms_sent",
          "sms_click"
        ]
      },
      "personalization": [
        "retentionOffer",
        "discountValue",
        "expiryDate"
      ]
    }
  ],
  "journey": {
    "type": "scheduled",
    "timeReference": "lastLoginDate",
    "nodes": [
      {
        "id": "n1",
        "type": "ENTRY",
        "event": "user_inactive",
        "eventId": "evt_user_inactive_001"
      },
      {
        "id": "n2",
        "type": "MESSAGE",
        "tpId": "TP1"
      },
      {
        "id": "n3",
        "type": "MESSAGE",
        "tpId": "TP2"
      },
      {
        "id": "n4",
        "type": "MESSAGE",
        "tpId": "TP3"
      },
      {
        "id": "n5",
        "type": "EXIT"
      }
    ]
  },
  "exitConditions": [
    {
      "event": "user_resumed_activity",
      "eventId": "evt_user_resumed_001",
      "action": "IMMEDIATE_EXIT"
    },
    {
      "event": "subscription_cancelled",
      "eventId": "evt_subscription_cancelled_001",
      "action": "IMMEDIATE_EXIT"
    }
  ],
  "ajoConfig": {
    "frequencyCapping": {
      "enabled": true,
      "maxMessagesPerUser": 3,
      "timeWindowDays": 14
    },
    "suppressionRules": [
      {
        "ruleId": "active_user",
        "condition": "user_resumed_activity == true"
      }
    ],
    "prioritization": {
      "priority": "HIGH"
    }
  },
  "tracking": {
    "globalEvents": [
      "journey_entered",
      "journey_exited",
      "content_resumed",
      "subscription_cancelled"
    ],
    "eventMapping": {
      "user_inactive": "evt_user_inactive_001",
      "user_resumed_activity": "evt_user_resumed_001",
      "subscription_cancelled": "evt_subscription_cancelled_001"
    }
  },
  "analytics": {
    "primaryKPI": "content_resumed",
    "secondaryKPIs": [
      "email_open",
      "email_click",
      "push_click",
      "sms_click",
      "watch_time"
    ],
    "attribution": {
      "model": "multi_touch",
      "lookbackDays": 14
    }
  },
  "version": "1.0",
  "status": "READY"
}
