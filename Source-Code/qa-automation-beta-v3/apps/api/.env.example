# QA Automation environment template
# Copy to `.env` (gitignored) and fill in values for whichever provider you use.

# Provider selector: anthropic (default) | openai | azure_openai | databricks
MODEL_PROVIDER=anthropic

# Install only the provider package you need — this keeps pip's resolver fast:
#   anthropic:    pip install -r requirements-anthropic.txt
#   openai:       pip install -r requirements-openai.txt
#   azure_openai: pip install -r requirements-openai.txt   (same package)
#   databricks:   pip install -r requirements-databricks.txt

# Anthropic — used when MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# OpenAI — used when MODEL_PROVIDER=openai
OPENAI_API_KEY=

# Azure OpenAI — used when MODEL_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
# Per-call timeout in seconds. Reasoning deployments (o1/o3/gpt-reasoning) are
# slow — keep this generous so long calls aren't cut off. Default: 180.
# AZURE_OPENAI_TIMEOUT=180

# Deployment name — three levels of specificity (first match wins):
#   1. Per-node:  AZURE_OPENAI_DEPLOYMENT_<NODE_UPPER>  (e.g. WALK_PROFILE, FIT_CHECK)
#   2. Global:    AZURE_OPENAI_DEPLOYMENT_NAME          (all nodes that lack a per-node override)
#   3. Fallback:  value in apps/api/app/llm/config.py   (default: marketing-segmentation-deployment)
AZURE_OPENAI_DEPLOYMENT_NAME=marketing-segmentation-deployment
# AZURE_OPENAI_DEPLOYMENT_FIT_CHECK=gpt-4.1
# AZURE_OPENAI_DEPLOYMENT_VERDICT_SUMMARY=gpt-4.1
# AZURE_OPENAI_DEPLOYMENT_WALK_PROFILE=gpt-4.1-mini
# AZURE_OPENAI_DEPLOYMENT_STRUCTURE_CHECK=gpt-4.1-mini
# AZURE_OPENAI_DEPLOYMENT_PROFILE_SYNTH=gpt-4.1-mini

# Databricks — used when MODEL_PROVIDER=databricks
# HOST is your workspace URL (no trailing slash), e.g. https://dbc-xxxxx-yyyy.cloud.databricks.com
# TOKEN is a Personal Access Token: User Settings → Developer → Access tokens → Generate
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# ── QA run tuning (all providers) ──────────────────────────────────────────
# A QA run walks every profile against every suite (cohort × suites). With a
# 24-profile cohort and 6 suites that is ~144 LLM calls — tune these for your
# provider's speed and rate limits.
#
# Max simultaneous LLM calls during the walk phase. Lower = fewer sporadic 5xx
# from rate-limited / overloaded deployments (esp. Azure reasoning models);
# higher = faster but riskier. Default: 2.
# QA_CONCURRENCY=2
#
# Cap on TOTAL walks per run (cohort × suites). 0 = unlimited. When exceeded the
# cohort is sampled down — suites are never dropped, so every suite still runs.
# Recommended for slow reasoning models, e.g. 30. Default: 0.
# QA_MAX_WALKS=0
#
# Wait simulation: seconds of real pause per walk to "simulate" the journey's
# timed touchpoint spacing (a visible "simulating Nd…" step is emitted). 0 = no
# pause. Default: 0.6.
# QA_WAIT_SIM_SECONDS=0.6
#
# Hard prompt-size ceiling in characters before we refuse to call the LLM
# (prevents context-overflow 400s). Default: 350000 (~87K tokens).
# QA_MAX_PROMPT_CHARS=350000
